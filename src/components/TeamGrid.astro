---
import PhotoPlaceholder from "./PhotoPlaceholder.astro";
import { coreTeam } from "../lib/site";
---

<section class="section" style="background-color: var(--color-primary-bg);" aria-labelledby="team-heading">
  <div class="container-site">
    <div class="max-w-2xl">
      <p class="eyebrow" style="color: var(--color-primary);">Jádro týmu</p>
      <h2 id="team-heading" class="mt-3">
        Lidé, kteří radnici rozumí
      </h2>
      <p class="mt-4 text-lg" style="color: var(--color-text-light);">
        Kandidátka má praktickou zkušenost — z radnice, z kraje, z podnikání
        i z komunitní práce. Nikdo neslibuje nemožné. Všichni chceme stejný cíl:
        Mariánky, kde se dobře žije celý rok.
      </p>
    </div>

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        coreTeam.map((member) => (
          <article class="reveal card card-hover text-left">
            <div class="w-28 h-28 mx-auto">
              <PhotoPlaceholder
                name={member.name}
                ratio="1/1"
                rounded="full"
              />
            </div>
            <h3
              class="mt-5 text-center text-xl font-bold"
              style="color: var(--color-dark);"
            >
              {member.name}
            </h3>
            <p
              class="mt-1 text-center text-sm font-semibold"
              style="color: var(--color-primary-light);"
            >
              {member.role}
            </p>
            <p
              class="mt-4 text-center text-[15px]"
              style="color: var(--color-text-light);"
            >
              {member.bio}
            </p>
          </article>
        ))
      }
    </div>

    <div
      class="mt-14 reveal card text-center max-w-2xl mx-auto"
      style="background-color: #fff;"
    >
      <h3 style="color: var(--color-dark); font-size: 1.25rem;">
        Kandidátku průběžně představujeme
      </h3>
      <p class="mt-3" style="color: var(--color-text-light);">
        Další kandidáty postupně zveřejníme v podcastu Ze sklepa
        a na sociálních sítích. Chcete být u toho? Sledujte nás.
      </p>
      <div class="mt-6 flex flex-wrap gap-3 justify-center">
        <a href="/podcast" class="btn btn-ghost">Podcast Ze sklepa</a>
        <a href="/kontakt" class="btn btn-ghost">Napište nám</a>
      </div>
    </div>
  </div>
</section>
