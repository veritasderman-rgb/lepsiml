---
import PhotoPlaceholder from "./PhotoPlaceholder.astro";
import {
  ballotName,
  candidates,
  featuredTeam,
  PARTY_PIRATI,
} from "../lib/site";
---

<section
  class="section"
  style="background-color: var(--color-spa-stone);"
  aria-labelledby="team-heading"
>
  <div class="container-site">
    <div class="max-w-2xl">
      <p class="eyebrow">Jádro týmu</p>
      <h2 id="team-heading" class="mt-3">Lidé, kteří radnici rozumí</h2>
      <p class="mt-4 text-lg" style="color: var(--color-smoke);">
        Kandidátka má praktickou zkušenost — z radnice, z kraje, z podnikání
        i z komunitní práce. Nikdo neslibuje nemožné. Všichni chceme stejný cíl:
        Mariánky, kde se dobře žije celý rok.
      </p>
    </div>

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        featuredTeam.map((member) => (
          <article class="reveal card card-hover text-left relative">
            <span class="candidate-number" aria-hidden="true">
              {member.order}
            </span>
            <div class="w-28 h-28 mx-auto">
              <PhotoPlaceholder
                name={member.name}
                ratio="1/1"
                rounded="full"
                src={member.photo}
              />
            </div>
            <h3
              class="mt-5 text-center"
              style="font-family: var(--font-body); font-weight: 700; text-transform: none; color: var(--color-ink); font-size: 1.375rem; line-height: 1.25; letter-spacing: -0.01em;"
            >
              <span class="sr-only">{member.order}. </span>
              {member.titles ? `${member.titles} ` : ""}
              {member.name}
            </h3>
            <p
              class="mt-1 text-center"
              style="font-family: var(--font-body); font-weight: 500; color: var(--color-pirate-dark); font-size: 14px; line-height: 1.4;"
            >
              {member.role ?? member.occupation}
            </p>
            <p
              class="mt-4 text-center text-[15px]"
              style="color: var(--color-smoke);"
            >
              {member.bio}
            </p>
            {member.personalMotivation && (
              <p
                class="mt-4 text-center text-[14px]"
                style="font-family: var(--font-body); font-style: italic; line-height: 1.55; color: var(--color-graphite); border-top: 1px solid var(--color-mist); padding-top: 14px;"
              >
                „{member.personalMotivation}“
              </p>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="section" aria-labelledby="ballot-heading">
  <div class="container-site">
    <div class="max-w-2xl">
      <p class="eyebrow">Kandidátní listina</p>
      <h2 id="ballot-heading" class="mt-3">Celá kandidátka</h2>
      <p class="mt-4 text-lg" style="color: var(--color-smoke);">
        Kompletní pořadí kandidátů do zastupitelstva Mariánských Lázní tak, jak
        je najdete na hlasovacím lístku.
      </p>
    </div>

    <ol class="ballot-list reveal mt-10">
      {
        candidates.map((c) => (
          <li class="ballot-row">
            <span class="ballot-num">{c.order}.</span>
            <div class="ballot-person">
              <p class="ballot-name">{ballotName(c)}</p>
              <p class="ballot-job">{c.occupation}</p>
            </div>
            <p class="ballot-meta">
              <span>{c.age} let</span>
              {c.residence && (
                <>
                  <span class="ballot-dot" aria-hidden="true">
                    ·
                  </span>
                  <span>{c.residence}</span>
                </>
              )}
            </p>
            <p
              class="ballot-party"
              data-party={c.affiliation === PARTY_PIRATI ? "pirati" : "bpp"}
            >
              {c.affiliation === PARTY_PIRATI ? "Piráti" : "Bez pol. přísl."}
            </p>
          </li>
        ))
      }
    </ol>

    <p class="mt-6 text-[14px]" style="color: var(--color-ash);">
      „Piráti“ = člen České pirátské strany. Ostatní kandidují jako nezávislí
      kandidáti bez politické příslušnosti.
    </p>

    <div
      class="mt-14 reveal card text-center max-w-2xl mx-auto"
      style="background-color: var(--color-paper);"
    >
      <h3
        style="font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.02em; color: var(--color-ink); font-size: 1.875rem;"
      >
        Kandidáty postupně představujeme
      </h3>
      <p class="mt-3" style="color: var(--color-smoke);">
        Medailonky dalších kandidátů zveřejňujeme průběžně na sociálních sítích.
        Chcete se na někoho zeptat? Napište nám.
      </p>
      <div class="mt-6 flex flex-wrap gap-3 justify-center">
        <a href="/kontakt" class="btn btn-ghost">Napište nám</a>
      </div>
    </div>
  </div>
</section>

<style>
  .candidate-number {
    position: absolute;
    top: 14px;
    left: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 30px;
    height: 30px;
    padding-inline: 6px;
    background-color: var(--color-ink);
    color: var(--color-paper);
    font-family: var(--font-display);
    font-size: 17px;
    line-height: 1;
    letter-spacing: 0.02em;
  }

  .ballot-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--color-ink);
  }

  .ballot-row {
    display: grid;
    grid-template-columns: 44px 1fr;
    grid-template-areas:
      "num person"
      ".   meta"
      ".   party";
    gap: 2px 8px;
    padding-block: 16px;
    border-bottom: 1px solid var(--color-mist);
  }

  @media (min-width: 768px) {
    .ballot-row {
      grid-template-columns: 52px minmax(0, 1fr) auto 150px;
      grid-template-areas: "num person meta party";
      align-items: baseline;
      gap: 16px;
    }
  }

  .ballot-row:hover {
    background-color: var(--color-spa-stone);
  }

  .ballot-num {
    grid-area: num;
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 1.2;
    color: var(--color-pirate-dark);
  }

  .ballot-person {
    grid-area: person;
  }

  .ballot-name {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 17px;
    line-height: 1.3;
    color: var(--color-ink);
    margin: 0;
  }

  .ballot-job {
    font-size: 14px;
    line-height: 1.45;
    color: var(--color-smoke);
    margin: 2px 0 0;
  }

  .ballot-meta {
    grid-area: meta;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--color-smoke);
    margin: 0;
    white-space: nowrap;
  }

  .ballot-dot {
    color: var(--color-ash);
  }

  .ballot-party {
    grid-area: party;
    justify-self: start;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 8px;
    margin: 2px 0 0;
    line-height: 1.2;
  }

  @media (min-width: 768px) {
    .ballot-party {
      justify-self: end;
      margin-top: 0;
    }
  }

  .ballot-party[data-party="pirati"] {
    background-color: var(--color-pirate);
    color: var(--color-ink);
  }

  .ballot-party[data-party="bpp"] {
    background-color: var(--color-mist);
    color: var(--color-smoke);
  }
</style>
