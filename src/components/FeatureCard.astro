---
import { Icon } from "astro-icon/components";

type Props = {
  icon: string;
  title: string;
  body: string;
  accent?: "primary" | "accent";
};

const { icon, title, body, accent = "primary" } = Astro.props;

const accentColor =
  accent === "accent" ? "var(--color-accent)" : "var(--color-primary)";
---

<article class="reveal card card-hover h-full flex flex-col">
  <span
    class="icon-badge icon-badge-lg"
    aria-hidden="true"
    style={`color: ${accentColor};`}
  >
    <Icon name={icon} width={34} height={34} />
  </span>
  <h3 class="mt-6" style="color: var(--color-dark); font-size: 1.375rem;">
    {title}
  </h3>
  <p class="mt-3 text-[15px]" style="color: var(--color-text-light);">
    {body}
  </p>
</article>
