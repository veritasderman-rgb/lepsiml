---
import PhotoPlaceholder from "./PhotoPlaceholder.astro";
import { leader } from "../lib/site";

type Props = {
  compact?: boolean;
  showCta?: boolean;
};

const { compact = false, showCta = true } = Astro.props;
---

<section class="section" aria-labelledby="leader-heading">
  <div class="container-site">
    <div
      class="reveal grid gap-10 md:gap-14 items-center"
      style={compact ? "" : "grid-template-columns: minmax(0, 1fr);"}
    >
      <div class="grid md:grid-cols-[minmax(260px,360px)_1fr] gap-10 md:gap-14 items-center">
        <div>
          <PhotoPlaceholder
            name={leader.name}
            ratio="3/4"
            rounded="md"
            src={leader.photo}
            alt="Vojta Franta — lídr kandidátky Za lepší Mariánské Lázně"
          />
        </div>
        <div>
          <p class="eyebrow" style="color: var(--color-primary);">
            Lídr kandidátky
          </p>
          <h2
            id="leader-heading"
            class="mt-3"
            style="color: var(--color-dark); font-size: clamp(1.75rem, 2vw + 1rem, 2.25rem);"
          >
            {leader.name}
          </h2>
          <p
            class="mt-2 font-semibold"
            style="color: var(--color-primary-light);"
          >
            {leader.role}
          </p>
          <p class="mt-6 text-[17px]" style="color: var(--color-text);">
            {leader.bio}
          </p>

          {
            leader.personalMotivation && (
              <p
                class="mt-5 text-[15px] italic"
                style="color: var(--color-text-light);"
              >
                {leader.personalMotivation}
              </p>
            )
          }

          {
            leader.quote && !compact && (
              <blockquote
                class="mt-8 pl-5 text-lg italic"
                style="border-left: 4px solid var(--color-accent); color: var(--color-dark);"
              >
                „{leader.quote}“
              </blockquote>
            )
          }

          {
            showCta && (
              <a
                href="/kandidati"
                class="mt-8 inline-flex items-center gap-2 font-bold"
                style="color: var(--color-primary);"
              >
                Celý tým
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <line x1="5" y1="12" x2="19" y2="12" />
                  <polyline points="12 5 19 12 12 19" />
                </svg>
              </a>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>
