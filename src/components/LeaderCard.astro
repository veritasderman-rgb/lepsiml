---
import PhotoPlaceholder from "./PhotoPlaceholder.astro";
import { leader } from "../lib/site";

type Props = {
  compact?: boolean;
  showCta?: boolean;
};

const { compact = false, showCta = true } = Astro.props;
---

<section class="section" aria-labelledby="leader-heading">
  <div class="container-site">
    <div
      class="reveal grid gap-10 md:gap-14 items-center"
      style={compact ? "" : "grid-template-columns: minmax(0, 1fr);"}
    >
      <div class="grid md:grid-cols-[minmax(260px,360px)_1fr] gap-10 md:gap-14 items-center">
        <div>
          <PhotoPlaceholder
            name={leader.name}
            ratio="3/4"
            rounded="md"
            src={leader.photo}
            alt="Vojta Franta — lídr kandidátky Za lepší Mariánské Lázně"
          />
        </div>
        <div>
          <p class="eyebrow">Lídr kandidátky</p>
          <h2
            id="leader-heading"
            class="mt-3"
            style="font-family: var(--font-body); font-weight: 800; text-transform: none; letter-spacing: -0.02em; color: var(--color-ink); font-size: clamp(2rem, 2.5vw + 1rem, 2.75rem); line-height: 1.1;"
          >
            {leader.name}
          </h2>
          <p
            class="mt-2"
            style="font-family: var(--font-body); font-weight: 500; color: var(--color-pirate-dark); font-size: 16px; line-height: 1.45;"
          >
            {leader.role}
          </p>
          <p class="mt-6 text-[17px]" style="color: var(--color-graphite);">
            {leader.bio}
          </p>

          {
            leader.personalMotivation && (
              <p
                class="mt-5 text-[16px] accent-quote"
                style="color: var(--color-spa-forest);"
              >
                {leader.personalMotivation}
              </p>
            )
          }

          {
            leader.quote && !compact && (
              <blockquote
                class="mt-8 pl-5 accent-quote"
                style="border-left: 4px solid var(--color-pirate); color: var(--color-ink); font-size: clamp(1.25rem, 1vw + 0.75rem, 1.625rem); line-height: 1.4;"
              >
                „{leader.quote}“
              </blockquote>
            )
          }

          {
            showCta && (
              <a
                href="/kandidati"
                class="mt-8 inline-flex items-center gap-2"
                style="font-family: var(--font-body); font-weight: 700; font-size: 16px; color: var(--color-pirate-dark);"
              >
                Celý tým
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <line x1="5" y1="12" x2="19" y2="12" />
                  <polyline points="12 5 19 12 12 19" />
                </svg>
              </a>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>
