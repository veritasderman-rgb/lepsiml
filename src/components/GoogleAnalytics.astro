---
/**
 * GA4 s Google Consent Mode v2.
 *
 * Načte se jen v produkčním buildu a jen když je nastavené PUBLIC_GA_ID —
 * bez proměnné se do stránky nedostane žádný kód třetí strany. Výchozí stav
 * souhlasu (denied) se nastaví ještě před gtag.js; uloženou volbu bere
 * z localStorage, takže vracející se návštěvník banner nevidí znovu.
 */
import { CONSENT_KEY, GA_ID } from "../lib/consent";

const enabled = import.meta.env.PROD && !!GA_ID;
---

{
  enabled && (
    <>
      <script is:inline define:vars={{ CONSENT_KEY }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        window.gtag = window.gtag || gtag;
        var granted = false;
        try {
          granted = localStorage.getItem(CONSENT_KEY) === "granted";
        } catch (e) {}
        // Reklamní souhlas zůstává vždycky denied — lišta mluví jen o měření
        // návštěvnosti, na reklamní účely se neptá, tak je nesmíme udělit.
        gtag("consent", "default", {
          ad_storage: "denied",
          ad_user_data: "denied",
          ad_personalization: "denied",
          analytics_storage: granted ? "granted" : "denied",
          wait_for_update: 500,
        });
      </script>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />
      <script is:inline define:vars={{ GA_ID }}>
        gtag("js", new Date());
        gtag("config", GA_ID);
      </script>
    </>
  )
}
