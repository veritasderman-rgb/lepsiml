---
type Props = {
  size?: number;
  variant?: "color" | "white";
};

const { size = 36, variant = "color" } = Astro.props;
const invert = variant === "white";
---

<img
  src="/logo.jpg"
  width={size}
  height={size}
  alt=""
  aria-hidden="true"
  class="logo-mark"
  style={`display:block; ${invert ? "filter: invert(1);" : ""}`}
  loading="eager"
  decoding="async"
/>
