---
type Props = {
  size?: number;
  variant?: "color" | "white";
};

const { size = 36, variant = "color" } = Astro.props;

const mainLeaf = variant === "white" ? "#ffffff" : "url(#leafGradLogo)";
const secondLeaf = variant === "white" ? "rgba(255,255,255,0.45)" : "#B7E4C7";
const secondOpacity = variant === "white" ? "0.45" : "0.6";
const vein = variant === "white" ? "rgba(255,255,255,0.35)" : "rgba(255,255,255,0.5)";
const drop = variant === "white" ? "rgba(255,255,255,0.85)" : "#D4A843";
const gradId = `leafGradLogo-${Math.random().toString(36).slice(2, 6)}`;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 48 72"
  width={size}
  height={Math.round(size * 1.5)}
  aria-hidden="true"
  class="logo-mark"
>
  {
    variant === "color" && (
      <defs>
        <linearGradient id={gradId} x1="0" y1="1" x2="0.5" y2="0">
          <stop offset="0%" stop-color="#2D6A4F" />
          <stop offset="100%" stop-color="#40916C" />
        </linearGradient>
      </defs>
    )
  }
  <g transform="translate(12, 28)">
    <path
      d="M 0 28 Q 0 -6 14 -28 Q 16 -12 28 0 Q 12 0 0 28Z"
      fill={variant === "color" ? `url(#${gradId})` : mainLeaf}
    />
    <path
      d="M -2 28 Q -10 0 -2 -20 Q 0 -7 10 2 Q 0 7 -2 28Z"
      fill={secondLeaf}
      opacity={secondOpacity}
    />
    <path
      d="M 0 26 Q 4 6 14 -26"
      fill="none"
      stroke={vein}
      stroke-width="1.2"
    />
    <ellipse cx="1" cy="34" rx="4" ry="4.5" fill={drop} />
  </g>
</svg>
