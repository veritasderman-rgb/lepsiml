---
type Props = {
  size?: number;
  variant?: "color" | "white";
};

const { size = 36, variant = "color" } = Astro.props;

const stroke = variant === "white" ? "#ffffff" : "#000000";
const fill = variant === "white" ? "#ffffff" : "#000000";
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 100"
  width={size}
  height={size}
  aria-hidden="true"
  class="logo-mark"
>
  <!-- Outer ring -->
  <circle
    cx="50"
    cy="50"
    r="46"
    fill="none"
    stroke={stroke}
    stroke-width="4"
  />

  <!-- Pirate flag with P (the loop of the P is the flag, the descender is the pole) -->
  <g fill={fill}>
    <!-- Flag pole / descender -->
    <rect x="29" y="18" width="6" height="56" rx="1" />
    <!-- Flag body — rounded right side to form the loop of "P" -->
    <path d="M 35 18 H 62 Q 78 18 78 31 V 38 Q 78 51 62 51 H 35 Z" />
  </g>
  <!-- White hole of the P -->
  <path
    d="M 41 26 H 60 Q 70 26 70 34.5 Q 70 43 60 43 H 41 Z"
    fill={variant === "white" ? "#000000" : "#ffffff"}
  />

  <!-- Mariánské Lázně skyline silhouette behind the flag -->
  <path
    fill={fill}
    d="M 16 80
       V 74
       H 22 V 70 H 28 V 74
       H 34 V 64 H 40 V 56
       H 43 V 50 H 46 V 56 H 49 V 64
       H 55 V 60 H 61 V 64 H 67 V 70
       H 73 V 74 H 79 V 70 H 84 V 80 Z"
  />
</svg>
