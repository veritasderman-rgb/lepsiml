---
type Props = {
  size?: number;
  variant?: "color" | "white";
};

const { size = 36, variant = "color" } = Astro.props;

const c = variant === "white" ? "#ffffff" : "#000000";
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 200 200"
  width={size}
  height={size}
  aria-hidden="true"
  class="logo-mark"
>
  <!-- Outer ring -->
  <circle cx="100" cy="100" r="88" fill="none" stroke={c} stroke-width="5" />

  <!-- Flag pole with small angled banner-tip pointing left at top -->
  <path
    fill={c}
    d="M 78 26
       L 94 32
       L 94 162
       L 88 162
       L 88 32
       Z"
  />

  <!-- Sail / P-bowl: solid, rounded, with curved waving bottom -->
  <path
    fill={c}
    d="M 94 34
       L 148 34
       Q 168 34 168 56
       Q 168 94 140 108
       Q 122 116 104 114
       Q 96 113 94 112
       Z"
  />

  <!-- Cross Spring pavilion silhouette (Křížový pramen) — lower right -->
  <g fill={c}>
    <!-- Spire / cross on dome -->
    <rect x="135" y="124" width="2.5" height="8" />
    <rect x="132" y="126" width="8.5" height="2" />
    <!-- Dome (onion shape) -->
    <path d="M 124 144 Q 124 132 136.5 127 Q 149 132 149 144 Z" />
    <!-- Central pavilion body (drum below dome) -->
    <rect x="125" y="144" width="23" height="11" />
    <!-- Left arch pier -->
    <path d="M 113 158
             V 148
             Q 113 142 119 142
             Q 125 142 125 148
             V 158 Z" />
    <!-- Right arch pier -->
    <path d="M 148 158
             V 148
             Q 148 142 154 142
             Q 160 142 160 148
             V 158 Z" />
    <!-- Connecting cornice between piers -->
    <rect x="116" y="153" width="42" height="3" />
    <!-- Base platform -->
    <rect x="108" y="156" width="54" height="3" />
  </g>
</svg>
