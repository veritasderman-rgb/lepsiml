---
import { Icon } from "astro-icon/components";
import { nav, site, contact, transparencyDashboard } from "../lib/site";
import LogoMark from "./LogoMark.astro";

const year = new Date().getFullYear();
---

<footer style="background-color: var(--color-ink); color: var(--color-paper);">
  <div
    style="height: 6px; background: linear-gradient(90deg, var(--color-pirate) 0% 60%, var(--color-spa-gold) 60% 100%);"
    aria-hidden="true"
  ></div>
  <div class="container-site py-16">
    <div class="grid gap-12 md:grid-cols-[1.2fr_1fr_1fr]">
      <div>
        <div class="flex items-center gap-3 mb-4">
          <LogoMark size={36} variant="white" />
          <span
            style="font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-paper); font-size: 20px;"
          >
            Za lepší Mariánské Lázně
          </span>
        </div>
        <p class="text-sm max-w-md" style="color: var(--color-mist);">
          Lokální kandidátka pro komunální volby 2026. Vojta Franta a tým
          s praktickou zkušeností z radnice i kraje.
        </p>
        <p
          class="mt-5 accent-quote"
          style="color: var(--color-pirate); font-size: 1.25rem;"
        >
          {site.claim}
        </p>
      </div>

      <div>
        <h4
          class="mono-meta mb-4"
          style="color: var(--color-pirate-light);"
        >
          Web
        </h4>
        <ul class="space-y-2 text-sm">
          {
            nav.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="hover:underline"
                  style="color: #fff;"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={transparencyDashboard.url}
              class="hover:underline"
              style="color: #fff;"
              rel="noopener"
            >
              {transparencyDashboard.name}
            </a>
            <span
              class="block text-xs mt-0.5"
              style="color: var(--color-ash);"
            >
              Transparentní data o městě — pokus ve spolupráci s AI
            </span>
          </li>
        </ul>
      </div>

      <div>
        <h4
          class="mono-meta mb-4"
          style="color: var(--color-pirate-light);"
        >
          Spojte se s námi
        </h4>
        <ul class="space-y-3 text-sm">
          <li>
            <a
              href={`mailto:${contact.email}`}
              class="inline-flex items-center gap-2"
              style="color: #fff;"
            >
              <Icon name="lucide:mail" width={18} height={18} />
              {contact.email}
            </a>
          </li>
          <li>
            <a
              href={`tel:${contact.phone.replace(/\s/g, "")}`}
              class="inline-flex items-center gap-2"
              style="color: #fff;"
            >
              <Icon name="lucide:phone" width={18} height={18} />
              {contact.phone}
            </a>
          </li>
          <li>
            <a
              href={contact.facebook}
              class="inline-flex items-center gap-2"
              style="color: #fff;"
              rel="me noopener"
              target="_blank"
            >
              <Icon name="lucide:facebook" width={18} height={18} />
              Facebook
            </a>
          </li>
          <li>
            <a
              href={contact.instagram}
              class="inline-flex items-center gap-2"
              style="color: #fff;"
              rel="me noopener"
              target="_blank"
            >
              <Icon name="lucide:instagram" width={18} height={18} />
              Instagram
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-12 pt-8 grid gap-6 md:grid-cols-[2fr_1fr] text-sm mono-meta"
      style="border-top: 1px solid rgba(255,255,255,0.14); color: var(--color-ash); text-transform: none; letter-spacing: 0.05em;"
    >
      <div>
        <p style="color: var(--color-paper); font-weight: 600;">Kontakt</p>
        <p class="mt-1">
          <a
            href={`mailto:${contact.email}`}
            style="color: var(--color-pirate);"
          >
            {contact.email}
          </a>
        </p>
        <p class="mt-1">
          <a
            href={`tel:${contact.phone.replace(/\s/g, "")}`}
            style="color: var(--color-pirate);"
          >
            {contact.phone}
          </a>
        </p>
      </div>
      <div class="md:text-right">
        <p>© {year} Za lepší Mariánské Lázně, z. s.</p>
        <p class="mt-1">Web vytvořen s péčí pro UNESCO město.</p>
      </div>
    </div>
  </div>
</footer>
