---
/**
 * Poděkování voličům po volbách. Vyskočí chvíli po načtení na kterékoli
 * stránce a po zavření se tomu prohlížeči už neukáže (localStorage; když
 * nejde zapisovat, aspoň jednou za návštěvu přes sessionStorage).
 * Bez JS se nevykreslí nic.
 */
import { Icon } from "astro-icon/components";
import { cislo, nas, nasZastupitel } from "../lib/volby2026";

const STORAGE_KEY = "plml.dekujemePopup.v1";
---

<div
  id="dek-popup"
  hidden
  class="fixed inset-0 z-[80] flex justify-center overflow-y-auto overscroll-contain p-4 sm:p-6"
  role="dialog"
  aria-modal="true"
  aria-labelledby="dek-popup-heading"
  aria-describedby="dek-popup-text"
>
  <div
    class="dek-popup-backdrop fixed inset-0"
    data-dek-popup-close
    aria-hidden="true"
  ></div>

  <div
    class="dek-popup-card relative w-full max-w-lg overflow-hidden mt-auto sm:my-auto"
    style="background: linear-gradient(135deg, #000000 0%, #0a1f1d 100%); border-top: 4px solid var(--color-pirate);"
  >
    <span
      class="hero-shape"
      style="width: 360px; height: 360px; top: -160px; right: -120px;"
      aria-hidden="true"></span>

    <button
      type="button"
      class="dek-popup-x absolute top-3 right-3 inline-flex items-center justify-center w-11 h-11 rounded-md transition-colors"
      style="color: var(--color-paper);"
      aria-label="Zavřít"
      data-dek-popup-close
    >
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="6" y1="6" x2="18" y2="18" />
        <line x1="6" y1="18" x2="18" y2="6" />
      </svg>
    </button>

    <div class="relative px-6 py-8 sm:px-9 sm:py-10">
      <span
        class="icon-badge icon-badge-lg"
        aria-hidden="true"
        style="color: var(--color-pirate); background: rgba(0, 178, 168, 0.14);"
      >
        <Icon name="lucide:heart-handshake" width={34} height={34} />
      </span>

      <p class="eyebrow mt-6 !flex" style="color: var(--color-pirate-light);">
        Komunální volby 2026 · Mariánské Lázně
      </p>
      <h2
        id="dek-popup-heading"
        class="mt-3"
        style="color: var(--color-paper); font-size: clamp(30px, 6vw, 42px); line-height: 1.02;"
      >
        Děkujeme všem, kdo nás volili
      </h2>
      <p id="dek-popup-text" class="mt-4 text-[16px] sm:text-lg" style="color: var(--color-mist);">
        Naše kandidátka dostala {cislo(nas.hlasy)} hlasů. Zastupitelem
        se za nás stal
        <strong style="color: var(--color-paper);">{nasZastupitel.jmeno}</strong>,
        jednička naší kandidátky. V zastupitelstvu bude prosazovat priority,
        které jsme vám ve volbách slíbili.
      </p>
      <p class="mt-4 text-[15px]" style="color: var(--color-mist);">
        Jak se daří vyjednat koalici, budeme psát v Aktualitách.
      </p>

      <div class="mt-7 flex flex-col sm:flex-row sm:items-center gap-3">
        <a href="/plan-1155/" class="btn btn-primary" data-dek-popup-go>
          Plán 2026–2030
        </a>
        <a href="/vysledky-voleb" class="btn btn-outline" data-dek-popup-go>
          Výsledky voleb
        </a>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ STORAGE_KEY }}>
  (function () {
    var popup = document.getElementById("dek-popup");
    if (!popup) return;

    // Poděkování stačí jednou: kdo ho zavřel, už ho neuvidí.
    var seen = null;
    try {
      seen = localStorage.getItem(STORAGE_KEY);
    } catch (e) {}
    try {
      seen = seen || sessionStorage.getItem(STORAGE_KEY);
    } catch (e) {}
    if (seen) return;

    var lastFocus = null;
    var LOCK_CLASS = "dek-popup-lock";
    var FOCUSABLE =
      'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

    function remember() {
      var now = String(Date.now());
      try {
        localStorage.setItem(STORAGE_KEY, now);
      } catch (e) {
        /* private mode – zkusíme aspoň tuhle návštěvu */
      }
      try {
        sessionStorage.setItem(STORAGE_KEY, now);
      } catch (e) {
        /* pop-up se příště ukáže znovu, nic horšího */
      }
    }

    function close() {
      if (popup.hidden) return;
      popup.hidden = true;
      document.documentElement.classList.remove(LOCK_CLASS);
      document.removeEventListener("keydown", onKey);
      remember();
      if (lastFocus && typeof lastFocus.focus === "function") lastFocus.focus();
    }

    function onKey(event) {
      if (event.key === "Escape") {
        close();
        return;
      }
      if (event.key !== "Tab") return;
      // Fokus zůstává v dialogu: za posledním prvkem jde zase na první a naopak.
      var items = Array.prototype.filter.call(
        popup.querySelectorAll(FOCUSABLE),
        function (el) {
          return el.offsetParent !== null;
        },
      );
      if (items.length === 0) return;
      var first = items[0];
      var last = items[items.length - 1];
      var active = document.activeElement;
      if (event.shiftKey && (active === first || !popup.contains(active))) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && (active === last || !popup.contains(active))) {
        event.preventDefault();
        first.focus();
      }
    }

    function open() {
      // Otevřené mobilní menu žije uvnitř hlavičky (vlastní z-index kontext),
      // takže by ho pop-up překryl. Počkáme, až ho návštěvník zavře.
      if (document.querySelector('[role="dialog"][aria-label="Hlavní menu"]')) {
        window.setTimeout(open, 800);
        return;
      }
      lastFocus = document.activeElement;
      document.documentElement.classList.add(LOCK_CLASS);
      popup.hidden = false;
      document.addEventListener("keydown", onKey);
      var go = popup.querySelector("[data-dek-popup-go]");
      // preventScroll: na nízkém displeji ať zůstane vidět začátek karty.
      if (go) go.focus({ preventScroll: true });
    }

    popup.addEventListener("click", function (event) {
      if (event.target.closest("[data-dek-popup-close]")) {
        event.preventDefault();
        close();
        return;
      }
      // Proklik dál: zapamatovat, ať se na další stránce neukáže znovu.
      if (event.target.closest("[data-dek-popup-go]")) remember();
    });

    // Krátká prodleva, ať si návštěvník nejdřív všimne stránky, na kterou přišel.
    window.setTimeout(open, 1200);
  })();
</script>

<style>
  .dek-popup-backdrop {
    background: rgba(0, 0, 0, 0.62);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    animation: dek-popup-fade 240ms ease-out both;
  }

  .dek-popup-card {
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.45);
    animation: dek-popup-rise 320ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .dek-popup-x:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }

  @keyframes dek-popup-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes dek-popup-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dek-popup-backdrop,
    .dek-popup-card {
      animation: none;
    }
  }
</style>
