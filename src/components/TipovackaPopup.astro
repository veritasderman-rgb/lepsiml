---
/**
 * Pop-up s tipovačkou — hlavní téma webu až do voleb. Vyskočí chvíli po
 * načtení na každé stránce kromě /tipovacka samotné, jednou za návštěvu
 * (sessionStorage), a po uzávěrce tipů (otevření volebních místností)
 * se už neukáže vůbec. Bez JS se nevykreslí nic.
 */
import { Icon } from "astro-icon/components";
import { TIP_UZAVERKA_ISO, tipMeta } from "../lib/tipovacka";

type Props = { pathname?: string };
const { pathname = "/" } = Astro.props;

const naTipovacce = pathname.replace(/\/$/, "") === "/tipovacka";
// Web je statický, takže tahle kontrola platí k času buildu — po uzávěrce
// se pop-up z nového deploye vyhodí úplně. Do té doby ho hlídá skript níž.
const poUzaverce = Date.now() >= new Date(TIP_UZAVERKA_ISO).getTime();
const enabled = !naTipovacce && !poUzaverce;

const STORAGE_KEY = "plml.tipovackaPopup.v1";
---

{ enabled && (

<div
  id="tip-popup"
  hidden
  class="fixed inset-0 z-[80] flex items-end sm:items-center justify-center p-4 sm:p-6"
  role="dialog"
  aria-modal="true"
  aria-labelledby="tip-popup-heading"
  aria-describedby="tip-popup-text"
>
  <div
    class="tip-popup-backdrop absolute inset-0"
    data-tip-popup-close
    aria-hidden="true"
  ></div>

  <div
    class="tip-popup-card relative w-full max-w-lg overflow-hidden"
    style="background: linear-gradient(135deg, #000000 0%, #0a1f1d 100%); border-top: 4px solid var(--color-spa-gold);"
  >
    <span
      class="hero-shape"
      style="width: 360px; height: 360px; top: -160px; right: -120px;"
      aria-hidden="true"></span>

    <button
      type="button"
      class="tip-popup-x absolute top-3 right-3 inline-flex items-center justify-center w-11 h-11 rounded-md transition-colors"
      style="color: var(--color-paper);"
      aria-label="Zavřít"
      data-tip-popup-close
    >
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="6" y1="6" x2="18" y2="18" />
        <line x1="6" y1="18" x2="18" y2="6" />
      </svg>
    </button>

    <div class="relative px-6 py-8 sm:px-9 sm:py-10">
      <span
        class="icon-badge icon-badge-lg"
        aria-hidden="true"
        style="color: var(--color-spa-gold); background: rgba(212, 162, 76, 0.12);"
      >
        <Icon name="lucide:trophy" width={34} height={34} />
      </span>

      <p class="eyebrow mt-6" style="color: var(--color-spa-gold);">
        Tipovačka · hrajeme o {tipMeta.cena}
      </p>
      <h2
        id="tip-popup-heading"
        class="mt-3"
        style="color: var(--color-paper); font-size: clamp(30px, 6vw, 42px); line-height: 1.02;"
      >
        {tipMeta.title}
      </h2>
      <p id="tip-popup-text" class="mt-4 text-[16px] sm:text-lg" style="color: var(--color-mist);">
        {tipMeta.intro}
      </p>
      <p class="mt-5 mono-meta" style="color: var(--color-pirate-light);">
        Tipy přijímáme do: {tipMeta.uzaverkaText}
      </p>

      <div class="mt-7 flex flex-col sm:flex-row sm:items-center gap-3">
        <a href="/tipovacka" class="btn btn-primary" data-tip-popup-go>
          Tipnout si
        </a>
        <button
          type="button"
          class="btn btn-outline"
          data-tip-popup-close
        >
          Teď ne
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ STORAGE_KEY, TIP_UZAVERKA_ISO }}>
  (function () {
    var popup = document.getElementById("tip-popup");
    if (!popup) return;

    // Po uzávěrce tipů (otevření volebních místností) už nemá co nabízet.
    if (Date.now() >= new Date(TIP_UZAVERKA_ISO).getTime()) return;

    // Jednou za návštěvu. Kdo zavřel, má do zavření karty/prohlížeče klid;
    // při další návštěvě ho tipovačka přivítá znovu — až do voleb.
    var seen = null;
    try {
      seen = sessionStorage.getItem(STORAGE_KEY);
    } catch (e) {}
    if (seen) return;

    var lastFocus = null;
    var prevOverflow = "";

    function remember() {
      try {
        sessionStorage.setItem(STORAGE_KEY, String(Date.now()));
      } catch (e) {
        /* private mode – pop-up se příště ukáže znovu, nic horšího */
      }
    }

    function close() {
      if (popup.hidden) return;
      popup.hidden = true;
      document.body.style.overflow = prevOverflow;
      document.removeEventListener("keydown", onKey);
      remember();
      if (lastFocus && typeof lastFocus.focus === "function") lastFocus.focus();
    }

    function onKey(event) {
      if (event.key === "Escape") close();
    }

    function open() {
      lastFocus = document.activeElement;
      prevOverflow = document.body.style.overflow;
      document.body.style.overflow = "hidden";
      popup.hidden = false;
      document.addEventListener("keydown", onKey);
      var go = popup.querySelector("[data-tip-popup-go]");
      if (go) go.focus();
    }

    popup.addEventListener("click", function (event) {
      if (event.target.closest("[data-tip-popup-close]")) {
        event.preventDefault();
        close();
        return;
      }
      // Proklik na tipovačku: zapamatovat, ať se po návratu neukáže znovu.
      if (event.target.closest("[data-tip-popup-go]")) remember();
    });

    // Krátká prodleva, ať si návštěvník nejdřív všimne stránky, na kterou přišel.
    window.setTimeout(open, 1200);
  })();
</script>

<style>
  .tip-popup-backdrop {
    background: rgba(0, 0, 0, 0.62);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    animation: tip-popup-fade 240ms ease-out both;
  }

  .tip-popup-card {
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.45);
    animation: tip-popup-rise 320ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .tip-popup-x:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }

  @keyframes tip-popup-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes tip-popup-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tip-popup-backdrop,
    .tip-popup-card {
      animation: none;
    }
  }
</style>
) }
