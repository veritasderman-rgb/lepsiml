---
import { site } from "../lib/site";

type Props = {
  label?: string;
  headline?: string;
  subheadline?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
};

const {
  label = site.election.toUpperCase(),
  headline = site.headline,
  subheadline = site.subheadline,
  primaryCta = { label: "Náš program", href: "/program" },
  secondaryCta = { label: "Poznejte kandidáty", href: "/kandidati" },
} = Astro.props;
---

<section
  class="relative overflow-hidden"
  style="background: linear-gradient(135deg, var(--color-dark) 0%, var(--color-primary) 100%);"
  aria-labelledby="hero-heading"
>
  <span
    class="hero-shape"
    style="width: 520px; height: 520px; top: -180px; right: -160px;"
    aria-hidden="true"></span>
  <span
    class="hero-shape"
    style="width: 360px; height: 360px; bottom: -140px; left: -120px; opacity: 0.06;"
    aria-hidden="true"></span>

  <div class="container-site relative py-20 md:py-32 lg:py-40">
    <div class="max-w-3xl">
      <p class="eyebrow reveal">{label}</p>
      <h1
        id="hero-heading"
        class="reveal mt-5 text-white"
        style="color: #fff; font-size: clamp(2rem, 4.5vw + 1rem, 3.5rem); line-height: 1.05;"
      >
        {headline}
      </h1>
      <p
        class="reveal mt-6 text-lg md:text-xl max-w-2xl"
        style="color: var(--color-primary-pale); line-height: 1.5;"
      >
        {subheadline}
      </p>

      <div class="reveal mt-10 flex flex-wrap gap-4">
        <a href={primaryCta.href} class="btn btn-primary">
          {primaryCta.label}
        </a>
        <a href={secondaryCta.href} class="btn btn-outline">
          {secondaryCta.label}
        </a>
      </div>
    </div>
  </div>
</section>
