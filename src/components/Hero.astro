---
import { site } from "../lib/site";

type Props = {
  label?: string;
  headline?: string;
  subheadline?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
};

const {
  label = site.election.toUpperCase(),
  headline = site.headline,
  subheadline = site.subheadline,
  primaryCta = { label: "Náš program", href: "/program" },
  secondaryCta = { label: "Poznejte kandidáty", href: "/kandidati" },
} = Astro.props;

const heroImage = "/IMG_20181014_165026.jpg";
---

<section
  class="hero relative overflow-hidden"
  aria-labelledby="hero-heading"
>
  <!-- Background photo (Mariánské Lázně — kolonáda na podzim) -->
  <img
    src={heroImage}
    alt=""
    aria-hidden="true"
    fetchpriority="high"
    decoding="async"
    class="hero-image"
  />

  <!-- Gradient overlay for legibility -->
  <div class="hero-overlay" aria-hidden="true"></div>

  <span
    class="hero-shape"
    style="width: 520px; height: 520px; top: -180px; right: -160px;"
    aria-hidden="true"></span>
  <span
    class="hero-shape"
    style="width: 360px; height: 360px; bottom: -140px; left: -120px; opacity: 0.06;"
    aria-hidden="true"></span>

  <div class="container-site relative py-20 md:py-32 lg:py-40">
    <div class="max-w-4xl">
      <p
        class="reveal mono-meta"
        style="color: var(--color-pirate-light);"
      >
        {label}
      </p>
      <h1
        id="hero-heading"
        class="reveal mt-5"
        style="color: var(--color-paper); font-size: clamp(3rem, 7vw + 1rem, 6rem); line-height: 0.95; text-shadow: 0 2px 20px rgba(0,0,0,0.35);"
      >
        {headline}
      </h1>
      <p
        class="reveal mt-6 text-lg md:text-xl max-w-2xl"
        style="font-family: var(--font-body); color: var(--color-mist); line-height: 1.5; text-shadow: 0 1px 10px rgba(0,0,0,0.35);"
      >
        {subheadline}
      </p>

      <div class="reveal mt-10 flex flex-wrap gap-4">
        <a href={primaryCta.href} class="btn btn-primary">
          {primaryCta.label}
        </a>
        <a href={secondaryCta.href} class="btn btn-outline">
          {secondaryCta.label}
        </a>
      </div>

      <p
        class="reveal mono-meta mt-8 flex flex-wrap items-center gap-x-5 gap-y-2"
        style="color: rgba(255,255,255,0.75);"
      >
        <span class="inline-flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          UNESCO 2021
        </span>
        <span class="inline-flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          Klimatické lázně 2023
        </span>
        <span class="inline-flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          Tým s praxí z radnice, kraje i lázní
        </span>
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    background-color: var(--color-dark);
    isolation: isolate;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
    z-index: 0;
    transform: scale(1.02); /* avoid 1px edge from blur */
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      135deg,
      rgba(0, 0, 0, 0.96) 0%,
      rgba(0, 0, 0, 0.88) 40%,
      rgba(0, 128, 120, 0.72) 100%
    );
  }

  .hero::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 6px;
    background: linear-gradient(
      90deg,
      var(--color-pirate) 0% 60%,
      var(--color-spa-gold) 60% 100%
    );
    z-index: 3;
  }

  .hero :global(.container-site),
  .hero > .hero-shape {
    position: relative;
    z-index: 2;
  }
</style>
