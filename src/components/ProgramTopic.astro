---
import { Icon } from "astro-icon/components";
import type { ProgramTopic } from "../lib/site";

type Props = { topic: ProgramTopic };
const { topic } = Astro.props;
---

<article
  id={topic.id}
  class="reveal card !p-0 overflow-hidden scroll-mt-24"
  style="background-color: #fff;"
>
  <div style={`height: 6px; background-color: ${topic.borderColor};`}></div>

  <details class="topic-section">
    <summary class="p-7 md:p-10">
      <div class="flex items-start gap-5 flex-wrap flex-1">
        <span
          class="icon-badge icon-badge-lg shrink-0"
          aria-hidden="true"
          style={`color: ${topic.borderColor};`}
        >
          <Icon name={topic.icon} width={36} height={36} />
        </span>
        <div class="flex-1 min-w-[260px]">
          <h2
            style="color: var(--color-dark); font-size: clamp(1.5rem, 2vw + 0.75rem, 2rem);"
          >
            {topic.title}
          </h2>
          <p class="mt-3 text-[17px]" style="color: var(--color-text);">
            {topic.lead}
          </p>
        </div>
      </div>
    </summary>

    <div class="px-7 pb-7 md:px-10 md:pb-10">
      <div class="mt-2">
        <p
          class="eyebrow"
          style="color: var(--color-primary); letter-spacing: 0.12em;"
        >
          Konkrétní sliby
        </p>
        <div class="mt-2">
          {
            topic.promises.map((promise) => (
              <details class="accordion">
                <summary>{promise.title}</summary>
                <div class="accordion-body">
                  <p>{promise.body}</p>
                </div>
              </details>
            ))
          }
        </div>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-2">
        <div
          class="rounded-xl p-6"
          style="background-color: #f6f1ec; border: 1px solid #eadfcf;"
        >
          <p
            class="eyebrow flex items-center gap-2"
            style="color: #8a5a00; letter-spacing: 0.12em;"
          >
            <Icon name="lucide:x" width={16} height={16} />
            Současné vedení města dělá
          </p>
          <ul class="mt-4 space-y-2 text-[15px]" style="color: #5a4920;">
            {
              topic.ano.map((line) => (
                <li class="flex gap-3">
                  <span aria-hidden="true" class="mt-[9px] w-1.5 h-1.5 rounded-full shrink-0" style="background-color: #8a5a00;"></span>
                  <span>{line}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div
          class="rounded-xl p-6"
          style="background-color: var(--color-primary-bg); border: 1px solid var(--color-border);"
        >
          <p
            class="eyebrow flex items-center gap-2"
            style="color: var(--color-primary); letter-spacing: 0.12em;"
          >
            <Icon name="lucide:check" width={16} height={16} />
            My nabízíme
          </p>
          <ul class="mt-4 space-y-2 text-[15px]" style="color: var(--color-dark);">
            {
              topic.us.map((line) => (
                <li class="flex gap-3">
                  <span aria-hidden="true" class="mt-[9px] w-1.5 h-1.5 rounded-full shrink-0" style="background-color: var(--color-primary);"></span>
                  <span>{line}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div
        class="mt-5 rounded-xl p-6 md:p-8"
        style="background-color: var(--color-accent-light); border: 1px solid #eadfcf;"
      >
        <p
          class="eyebrow flex items-center gap-2"
          style="color: #8a5a00; letter-spacing: 0.12em;"
        >
          <Icon name="lucide:heart-handshake" width={18} height={18} />
          A co z toho budete mít vy
        </p>
        <ul class="mt-5 grid gap-3 md:grid-cols-2 text-[15px]" style="color: var(--color-dark);">
          {
            topic.forYou.map((line) => (
              <li class="flex gap-3 items-start">
                <span
                  class="shrink-0 mt-0.5 inline-flex items-center justify-center w-5 h-5 rounded-full"
                  style="background-color: var(--color-accent); color: var(--color-dark);"
                  aria-hidden="true"
                >
                  <Icon name="lucide:check" width={13} height={13} />
                </span>
                <span>{line}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div
        class="mt-5 rounded-xl p-6 md:p-7"
        style="background-color: #fff; border: 1px dashed var(--color-border);"
      >
        <p
          class="eyebrow flex items-center gap-2"
          style="color: var(--color-text-light); letter-spacing: 0.12em;"
        >
          <Icon name="lucide:alert-triangle" width={16} height={16} />
          Co nebude snadné — a my vám to říkáme předem
        </p>
        <ul class="mt-4 space-y-3 text-[14px]" style="color: var(--color-text);">
          {
            topic.challenges.map((line) => (
              <li class="flex gap-3 items-start">
                <span
                  aria-hidden="true"
                  class="mt-[7px] w-1.5 h-1.5 rounded-full shrink-0"
                  style="background-color: var(--color-text-light);"
                />
                <span>{line}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </details>
</article>
