---
import { nav, navCta, site } from "../lib/site";
import MobileMenu from "./MobileMenu.tsx";
import LogoMark from "./LogoMark.astro";

type Props = { pathname?: string };
const { pathname = "/" } = Astro.props;
---

<header class="sticky top-0 z-50" style="background-color: var(--color-ink);">
  <div class="container-site flex items-center justify-between gap-4 py-4">
    <a
      href="/"
      class="flex items-center gap-3 text-white"
      aria-label={`${site.name} — domů`}
    >
      <LogoMark size={32} variant="white" />
      <span class="flex flex-col leading-tight">
        <span
          class="whitespace-nowrap"
          style="font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-paper); font-size: 18px;"
        >
          Za lepší Mariánské Lázně
        </span>
        <span
          class="hidden sm:block mono-meta"
          style="color: var(--color-pirate-light); font-size: 10px;"
        >
          Mariánské Lázně 2026–2030
        </span>
      </span>
    </a>

    <nav class="hidden xl:flex items-center gap-1" aria-label="Hlavní navigace">
      {
        nav.map((link) => {
          const active =
            !link.external &&
            (pathname === link.href ||
              (link.href !== "/" && pathname.startsWith(link.href)));
          return (
            <a
              href={link.href}
              class="px-1.5 py-2 transition-colors inline-flex items-center gap-1.5 whitespace-nowrap"
              style={`font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.05em; font-size: 15px; color: ${active ? "var(--color-pirate)" : "var(--color-paper)"};`}
              data-active={active}
              title={link.fullLabel}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener" : undefined}
            >
              {link.label}
              {link.external && (
                <>
                  <svg
                    width="12"
                    height="12"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    style="opacity: 0.7;"
                  >
                    <path d="M7 17 17 7" />
                    <path d="M9 7h8v8" />
                  </svg>
                  <span class="sr-only">(otevře se v novém okně)</span>
                </>
              )}
            </a>
          );
        })
      }
      <a href={navCta.href} class="btn btn-primary ml-1 !py-[10px] !px-3 !text-sm whitespace-nowrap">
        {navCta.label}
      </a>
    </nav>

    <MobileMenu client:load links={nav} cta={navCta} pathname={pathname} />
  </div>
</header>

<style>
  header nav a[data-active="false"]:hover {
    background-color: rgba(255, 255, 255, 0.08);
  }
</style>
