---
import Base from "../layouts/Base.astro";
import MeetingList from "../components/MeetingList.astro";
import { Icon } from "astro-icon/components";
import { contact } from "../lib/site";
---

<Base
  title="Setkání"
  description="Potkejme se naživo — veřejné besedy, čtvrťová fóra a neformální setkání s Vojtou Frantou a týmem Za lepší Mariánské Lázně."
>
  <!-- Header -->
  <section
    class="relative overflow-hidden"
    style="background: linear-gradient(135deg, #000000 0%, #0a1f1d 100%);"
  >
    <span
      class="hero-shape"
      style="width: 480px; height: 480px; top: -180px; right: -140px;"
      aria-hidden="true"></span>
    <div class="container-site relative py-20 md:py-28">
      <p class="eyebrow">Potkejme se</p>
      <h1 class="reveal mt-4" style="color: #fff;">
        Přijdeme za vámi do vaší čtvrti
      </h1>
      <p
        class="reveal mt-6 text-lg md:text-xl max-w-2xl"
        style="color: var(--color-primary-pale);"
      >
        Program se nedělá v kanceláři. Chceme od vás slyšet, co vám
        v Mariánkách chybí, co funguje a co by fungovat mělo. Proto vyrazíme
        za lidmi do každé čtvrti — ne jednou za čtyři roky, ale pravidelně.
      </p>
    </div>
  </section>

  <!-- Meetings list -->
  <section class="section" style="background-color: var(--color-off-white);">
    <div class="container-site">
      <div class="max-w-2xl mb-10">
        <p class="eyebrow" style="color: var(--color-primary);">Nadcházející</p>
        <h2 class="mt-3">Kam za námi můžete přijít</h2>
        <p class="mt-4 text-lg" style="color: var(--color-text-light);">
          Termíny postupně doplňujeme. Chcete, abychom přišli i k vám? Napište
          nám — uspořádáme besedu tam, kde je zájem.
        </p>
      </div>

      <MeetingList />

      <div
        class="mt-14 card text-center max-w-2xl mx-auto"
        style="background-color: var(--color-primary-bg); border-color: var(--color-primary-pale);"
      >
        <span
          class="icon-badge icon-badge-lg mx-auto"
          style="color: var(--color-primary);"
          aria-hidden="true"
        >
          <Icon name="lucide:users" width={30} height={30} />
        </span>
        <h3 class="mt-5" style="color: var(--color-dark); font-size: 1.375rem;">
          Chcete besedu ve vaší čtvrti?
        </h3>
        <p class="mt-3" style="color: var(--color-text);">
          Pokud je u vás zájem o otevřenou debatu, napište nám. Rádi přijedeme
          a domluvíme termín, který bude vyhovovat vám.
        </p>
        <div class="mt-6 flex flex-wrap gap-3 justify-center">
          <a href={`mailto:${contact.email}`} class="btn btn-primary">
            <Icon name="lucide:mail" width={16} height={16} />
            Napsat e-mail
          </a>
          <a href="/kontakt" class="btn btn-ghost">Další kontakty</a>
        </div>
      </div>
    </div>
  </section>
</Base>
