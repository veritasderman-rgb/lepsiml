---
import Base from "../layouts/Base.astro";
import {
  KLAUZULE,
  MANDATU,
  SOUCET_TOLERANCE,
  TIP_MAX,
  TIP_UZAVERKA_ISO,
  kandidatky,
  tipDisclaimer,
  tipEndpoint,
  tipMeta,
  tipNovinky,
  tipPravidla,
  tipPrumerPoznamka,
  tipSouhlas,
} from "../lib/tipovacka";
---

<Base title={tipMeta.title} description={tipMeta.intro}>
  <!-- ============ HERO ============ -->
  <section
    class="relative overflow-hidden"
    style="background: linear-gradient(135deg, #000000 0%, #0a1f1d 100%);"
    aria-labelledby="tip-heading"
  >
    <span
      class="hero-shape"
      style="width: 500px; height: 500px; top: -190px; right: -150px;"
      aria-hidden="true"></span>
    <div class="container-site relative py-20 md:py-24">
      <p class="eyebrow" style="color: var(--color-pirate-light);">
        Tipovačka · hrajeme o {tipMeta.cena}
      </p>
      <h1 id="tip-heading" class="reveal mt-4" style="color: var(--color-paper); max-width: 20ch;">
        {tipMeta.title}
      </h1>
      <p class="reveal mt-6 text-lg md:text-xl max-w-2xl" style="color: var(--color-mist);">
        {tipMeta.intro}
      </p>
      <p class="reveal mt-6 mono-meta" style="color: var(--color-pirate-light);">
        Tipy přijímáme do: {tipMeta.uzaverkaText}
      </p>
    </div>
  </section>

  <!-- ============ PRŮMĚR TIPŮ ============ -->
  <section
    class="section"
    style="background-color: var(--color-off-white);"
    aria-labelledby="prumer-heading"
  >
    <div class="container-site max-w-4xl">
      <p class="eyebrow">Jak tipujete vy</p>
      <h2 id="prumer-heading" class="mt-3">Zastupitelstvo podle vašich tipů</h2>
      <p id="prumer-stav" class="mt-4 text-lg" style="color: var(--color-smoke);">
        Načítáme průměr tipů…
      </p>

      <div id="prumer" hidden>
        <div class="mt-8 card !p-5 md:!p-7">
          <p class="mono-meta" style="color: var(--color-smoke);">
            {MANDATU} mandátů
          </p>
          <div id="prumer-kresla" class="kresla mt-3" aria-hidden="true"></div>
        </div>
        <ul id="prumer-radky" class="mt-6 grid gap-2"></ul>
        <p class="mt-6 text-[14px]" style="color: var(--color-smoke);">
          {tipPrumerPoznamka}
        </p>
      </div>
    </div>
  </section>

  <!-- ============ FORMULÁŘ ============ -->
  <section class="section" aria-labelledby="form-heading">
    <div class="container-site max-w-4xl">
      <p class="eyebrow">Váš tip</p>
      <h2 id="form-heading" class="mt-3">Rozdělte 100 % hlasů</h2>
      <p class="mt-4 text-lg" style="color: var(--color-smoke);">
        Kandidátky jsou v pořadí podle čísla na hlasovacím lístku. Posuvníkem nastavte
        odhad pro každou kandidátku. Pod formulářem hned uvidíte, jak by
        podle vašeho tipu vypadalo zastupitelstvo.
      </p>

      <p id="uzavreno" class="mt-8 card dekujeme" hidden>
        Tipovačka je uzavřená — volební místnosti už jsou otevřené. Výherce
        vyhlásíme po zveřejnění výsledků.
      </p>

      <form
        id="tip-form"
        class="mt-8"
        novalidate
        data-endpoint={tipEndpoint}
        data-uzaverka={TIP_UZAVERKA_ISO}
        data-tolerance={SOUCET_TOLERANCE}
      >
        <div class="hp" aria-hidden="true">
          <label>Web <input type="text" name="web" tabindex="-1" autocomplete="off" /></label>
        </div>

        <fieldset class="card q-card">
          <legend class="q-legend">
            <span class="mono-meta" style="color: var(--color-pirate-dark);">Výsledek voleb</span>
            <span class="q-title">Kolik procent hlasů dostane která kandidátka?</span>
          </legend>

          <div class="mt-5 grid gap-2">
            {kandidatky.map((k) => (
              <label class:list={["strana", { "strana-nase": k.nase }]}>
                <span class="strana-cislo">{k.cislo}</span>
                <span class="strana-nazev">{k.nazev}</span>
                <output class="strana-hodnota" data-hodnota={k.cislo}>0 %</output>
                <input
                  type="range"
                  class="posuvnik"
                  min="0"
                  max={TIP_MAX}
                  step="0.5"
                  value="0"
                  name={`tip-${k.cislo}`}
                  data-cislo={k.cislo}
                  aria-label={`Tip pro kandidátku ${k.cislo}, ${k.nazev}, v procentech`}
                />
              </label>
            ))}
          </div>

          <div class="mt-5 flex flex-wrap items-stretch gap-3">
            <div class="soucet flex-1" id="soucet" data-ok="false" role="status" aria-live="polite">
              Součet: 0 % — zbývá rozdělit 100 %
            </div>
            <button type="button" id="dorovnat" class="btn btn-ghost !py-2 !text-base">
              Dorovnat na 100 %
            </button>
          </div>
          <p class="mt-2 text-[13px]" style="color: var(--color-smoke);">
            Tlačítko zachová poměry mezi vašimi tipy a přepočítá je tak, aby
            dohromady daly přesně 100 %.
          </p>

          <div class="mt-6">
            <p class="mono-meta" style="color: var(--color-smoke);">
              Váš tip v mandátech (klauzule {KLAUZULE} %)
            </p>
            <div id="muj-kresla" class="kresla mt-3" aria-hidden="true"></div>
          </div>
        </fieldset>

        <fieldset class="card q-card mt-6" style="border-left: 4px solid var(--color-spa-gold);">
          <legend class="q-legend">
            <span class="mono-meta" style="color: var(--color-pirate-dark);">Rozhoduje při shodě</span>
            <span class="q-title">Jaká bude volební účast?</span>
          </legend>
          <label class="ucast mt-4">
            <span class="pole-label">Účast</span>
            <output class="strana-hodnota" id="ucast-hodnota">40 %</output>
            <input type="range" class="posuvnik" name="tipUcast" min="10" max="90" step="0.5" value="40" aria-label="Tip na volební účast v procentech" />
          </label>
        </fieldset>

        <fieldset class="card q-card mt-6">
          <legend class="q-legend">
            <span class="mono-meta" style="color: var(--color-pirate-dark);">Kontakt</span>
            <span class="q-title">Kam vám dáme vědět, že jste vyhráli?</span>
          </legend>

          <div class="mt-5 grid gap-4 sm:grid-cols-3">
            <label class="pole">
              <span class="pole-label">E-mail</span>
              <input type="email" name="email" maxlength="254" autocomplete="email" required />
            </label>
            <label class="pole">
              <span class="pole-label">Jméno (volitelné)</span>
              <input type="text" name="jmeno" maxlength="100" autocomplete="name" />
            </label>
            <label class="pole">
              <span class="pole-label">Telefon (volitelné)</span>
              <input type="tel" name="telefon" maxlength="40" autocomplete="tel" />
            </label>
          </div>

          <label class="opt mt-5 souhlas">
            <input type="checkbox" name="plnolety" value="1" />
            <span>Je mi 18 let nebo víc.</span>
          </label>
          <label class="opt mt-3 souhlas">
            <input type="checkbox" name="souhlas" value="1" />
            <span>{tipSouhlas}</span>
          </label>
          <label class="opt mt-3 souhlas">
            <input type="checkbox" name="novinky" value="1" />
            <span>{tipNovinky} (nepovinné)</span>
          </label>
        </fieldset>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <button type="submit" class="btn btn-primary" id="odeslat">Odeslat tip</button>
          <p id="stav" class="stav" role="status" aria-live="polite"></p>
        </div>
      </form>

      <div id="hotovo" class="card dekujeme mt-8" hidden>
        <p class="eyebrow">Odesláno</p>
        <h2 class="mt-3">Tip máme. Držte si palce!</h2>
        <p class="mt-4" style="color: var(--color-smoke);">
          Po volbách tipy vyhodnotíme a výherci napíšeme e-mail. Mezitím se
          můžete podívat, s čím do voleb jdeme.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/program" class="btn btn-ghost">Náš program</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PRAVIDLA ============ -->
  <section class="section" style="background-color: var(--color-ink);" aria-labelledby="pravidla-heading">
    <div class="container-site max-w-4xl">
      <p class="eyebrow" style="color: var(--color-pirate-light);">Pravidla</p>
      <h2 id="pravidla-heading" class="mt-3" style="color: var(--color-paper);">Jak soutěž funguje</h2>
      <ol class="mt-8 grid gap-3">
        {tipPravidla.map((p, i) => (
          <li class="pravidlo">
            <span class="pravidlo-cislo">{i + 1}</span>
            <span>{p}</span>
          </li>
        ))}
      </ol>
      <p class="mt-10 text-[13px]" style="color: var(--color-ash); line-height: 1.6;">
        {tipDisclaimer}
      </p>
    </div>
  </section>
</Base>

<script>
  import { MANDATU, TIP_MAX, kandidatky, prepocetMandatu, tipEndpoint } from "../lib/tipovacka";

  const nase = kandidatky.find((k) => k.nase)?.cislo;
  const cz = (n: number) => n.toFixed(1).replace(".", ",").replace(",0", "");

  /** Nakreslí 21 křesel: čtverečky s číslem kandidátky, naše tyrkysově. */
  function kresla(el: HTMLElement, mandaty: Record<number, number>) {
    el.replaceChildren();
    const serazene = kandidatky
      .map((k) => k.cislo)
      .filter((c) => mandaty[c] > 0)
      .sort((a, b) => mandaty[b] - mandaty[a] || a - b);
    let obsazeno = 0;
    for (const c of serazene) {
      for (let i = 0; i < mandaty[c]; i++) {
        const s = document.createElement("span");
        s.className = c === nase ? "kreslo kreslo-nase" : "kreslo";
        s.textContent = String(c);
        el.append(s);
        obsazeno++;
      }
    }
    for (; obsazeno < MANDATU; obsazeno++) {
      const s = document.createElement("span");
      s.className = "kreslo kreslo-prazdne";
      el.append(s);
    }
  }

  // ---------- Průměr tipů ----------
  (async function () {
    const stav = document.getElementById("prumer-stav")!;
    const blok = document.getElementById("prumer")!;
    try {
      const r = await fetch(tipEndpoint);
      const d = await r.json();
      if (!r.ok) throw new Error();
      if (d.karence) {
        stav.textContent =
          "Od úterý 6. října do konce hlasování platí zákonné moratorium na zveřejňování předvolebních průzkumů, proto průměr tipů teď neukazujeme. Tipovat ale můžete dál až do pátku 9. října 14:00.";
        return;
      }
      if (!d.prumery) {
        stav.textContent = `Průměr ukážeme, jakmile bude aspoň ${d.min} tipů. Zatím jich máme ${d.pocet}. Buďte mezi prvními!`;
        return;
      }
      stav.textContent = `Z ${d.pocet} tipů. Průměrný odhad účasti: ${cz(d.ucast)} %.`;
      kresla(document.getElementById("prumer-kresla")!, d.mandaty);
      const ul = document.getElementById("prumer-radky")!;
      const max = Math.max(...Object.values(d.prumery as Record<number, number>), 1);
      const serazene = [...kandidatky].sort((a, b) => d.prumery[b.cislo] - d.prumery[a.cislo]);
      for (const k of serazene) {
        const li = document.createElement("li");
        li.className = k.nase ? "radek radek-nase" : "radek";
        const pct = d.prumery[k.cislo];
        const m = d.mandaty[k.cislo];
        li.innerHTML = `
          <span class="radek-cislo"></span>
          <span class="radek-nazev"></span>
          <span class="radek-bar"><span style="width:${(pct / max) * 100}%"></span></span>
          <span class="radek-pct"></span>
          <span class="radek-m"></span>`;
        li.querySelector(".radek-cislo")!.textContent = String(k.cislo);
        li.querySelector(".radek-nazev")!.textContent = k.nazev;
        li.querySelector(".radek-pct")!.textContent = `${cz(pct)} %`;
        li.querySelector(".radek-m")!.textContent = m === 1 ? "1 mandát" : m >= 2 && m <= 4 ? `${m} mandáty` : `${m} mandátů`;
        ul.append(li);
      }
      blok.hidden = false;
    } catch {
      stav.textContent = "Průměr tipů se teď nepodařilo načíst.";
    }
  })();

  // ---------- Formulář ----------
  const form = document.getElementById("tip-form") as HTMLFormElement | null;
  if (form) {
    const uzaverka = new Date(form.dataset.uzaverka!).getTime();
    const tolerance = Number(form.dataset.tolerance);
    const soucetEl = document.getElementById("soucet")!;
    const mujKresla = document.getElementById("muj-kresla")!;
    const stav = document.getElementById("stav")!;
    const tlacitko = document.getElementById("odeslat") as HTMLButtonElement;
    const pole = [...form.querySelectorAll<HTMLInputElement>("input[data-cislo]")];

    if (Date.now() >= uzaverka) {
      form.hidden = true;
      document.getElementById("uzavreno")!.hidden = false;
    }

    const cislo = (v: string) => {
      const s = v.trim().replace(",", ".");
      if (s === "") return 0;
      const n = Number(s);
      return Number.isFinite(n) && n >= 0 && n <= 100 ? n : NaN;
    };

    function tipy(): Record<number, number> {
      return Object.fromEntries(pole.map((i) => [Number(i.dataset.cislo), cislo(i.value)]));
    }

    const pul = (n: number) => Math.round(n * 2) / 2;

    /** Zachová poměry tipů a přepočítá je na součet 100 (po půlprocentech). */
    function dorovnej() {
      let h = pole.map((i) => Number(i.value));
      for (let kolo = 0; kolo < 5; kolo++) {
        const s = h.reduce((a, b) => a + b, 0);
        if (s === 0) return;
        h = h.map((x) => Math.min(TIP_MAX, pul((x * 100) / s)));
        let zbytek = pul(100 - h.reduce((a, b) => a + b, 0));
        // Zaokrouhlovací zbytek přidáme / ubereme u největších tipů.
        const poradi = h.map((x, i) => i).sort((a, b) => h[b] - h[a]);
        for (const i of poradi) {
          if (zbytek === 0) break;
          const nova = Math.min(TIP_MAX, Math.max(0, h[i] + zbytek));
          zbytek = pul(zbytek - (nova - h[i]));
          h[i] = nova;
        }
        if (zbytek === 0) break;
      }
      pole.forEach((i, k) => (i.value = String(h[k])));
      prepocitej();
    }
    document.getElementById("dorovnat")!.addEventListener("click", dorovnej);

    const ucast = form.elements.namedItem("tipUcast") as HTMLInputElement;
    const ucastHodnota = document.getElementById("ucast-hodnota")!;
    const ukazUcast = () => (ucastHodnota.textContent = `${cz(Number(ucast.value))} %`);
    ucast.addEventListener("input", ukazUcast);
    ukazUcast();

    function prepocitej() {
      for (const i of pole) {
        const out = form!.querySelector<HTMLElement>(`[data-hodnota="${i.dataset.cislo}"]`);
        if (out) out.textContent = `${cz(Number(i.value))} %`;
        i.setAttribute("aria-valuetext", `${cz(Number(i.value))} procent`);
        i.style.setProperty("--plneni", `${(Number(i.value) / TIP_MAX) * 100}%`);
      }
      const t = tipy();
      const hodnoty = Object.values(t);
      const spatne = hodnoty.some((n) => Number.isNaN(n));
      const soucet = hodnoty.reduce((a, b) => a + (Number.isNaN(b) ? 0 : b), 0);
      const ok = !spatne && Math.abs(soucet - 100) <= tolerance;
      soucetEl.dataset.ok = String(ok);
      if (spatne) soucetEl.textContent = "Některé pole nemá platné číslo (0–100).";
      else if (ok) soucetEl.textContent = `Součet: ${cz(soucet)} % — sedí.`;
      else if (soucet < 100) soucetEl.textContent = `Součet: ${cz(soucet)} % — zbývá rozdělit ${cz(100 - soucet)} %`;
      else soucetEl.textContent = `Součet: ${cz(soucet)} % — o ${cz(soucet - 100)} % víc, než je 100 %`;
      const cista = Object.fromEntries(Object.entries(t).map(([k, v]) => [k, Number.isNaN(v) ? 0 : v]));
      kresla(mujKresla, prepocetMandatu(cista));
      return ok;
    }
    form.addEventListener("input", (e) => {
      if ((e.target as HTMLElement).dataset?.cislo) prepocitej();
    });
    prepocitej();

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const chyba = (text: string) => {
        stav.dataset.typ = "chyba";
        stav.textContent = text;
      };
      if (!prepocitej()) return chyba("Tipy musí dát dohromady 100 %.");
      if (!String(fd.get("email") || "").trim()) return chyba("Doplňte prosím e-mail, ať se vám můžeme ozvat.");
      if (fd.get("plnolety") !== "1" || fd.get("souhlas") !== "1")
        return chyba("Potvrďte prosím, že je vám 18 let, a souhlas s pravidly.");

      const data = {
        web: fd.get("web") || "",
        tip: Object.fromEntries(pole.map((i) => [i.dataset.cislo, i.value])),
        tipUcast: fd.get("tipUcast"),
        email: fd.get("email"),
        jmeno: fd.get("jmeno") || "",
        telefon: fd.get("telefon") || "",
        plnolety: true,
        souhlas: true,
        novinky: fd.get("novinky") === "1",
      };

      tlacitko.disabled = true;
      stav.dataset.typ = "";
      stav.textContent = "Odesíláme…";
      try {
        const r = await fetch(form.dataset.endpoint!, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(data),
        });
        if (r.ok) {
          form.hidden = true;
          const hotovo = document.getElementById("hotovo")!;
          hotovo.hidden = false;
          hotovo.scrollIntoView({ behavior: "smooth", block: "start" });
          return;
        }
        const telo = await r.json().catch(() => ({}));
        chyba(telo.chyba || "Odeslání se nepovedlo. Zkuste to prosím znovu.");
      } catch {
        chyba("Nepodařilo se spojit se serverem. Zkontrolujte připojení a zkuste to znovu.");
      } finally {
        tlacitko.disabled = false;
      }
    });
  }
</script>

<style>
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .q-card { background-color: var(--color-paper); }
  .q-legend { display: block; padding: 0; }
  .q-title {
    display: block;
    margin-top: 10px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(1.25rem, 1.5vw + 0.875rem, 1.625rem);
    line-height: 1.25;
    color: var(--color-ink);
  }

  .strana {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) auto;
    grid-template-areas: "c n h" "p p p";
    align-items: center;
    column-gap: 12px;
    row-gap: 10px;
    padding: 12px 14px;
    background-color: var(--color-cream);
    border: 1px solid var(--color-mist);
  }
  @media (min-width: 768px) {
    .strana {
      grid-template-columns: 36px minmax(0, 1fr) minmax(0, 1.2fr) 64px;
      grid-template-areas: "c n p h";
    }
  }
  .strana:focus-within { border-color: var(--color-pirate); }
  .strana-nase { border-left: 4px solid var(--color-pirate); }
  .strana-cislo {
    grid-area: c;
    display: inline-flex; align-items: center; justify-content: center;
    width: 36px; height: 36px;
    background-color: var(--color-ink); color: var(--color-paper);
    font-family: var(--font-display); font-size: 18px; line-height: 1;
  }
  .strana-nase .strana-cislo { background-color: var(--color-pirate); color: var(--color-ink); }
  .strana-nazev { grid-area: n; font-size: 15px; line-height: 1.3; color: var(--color-ink); }
  .strana-hodnota {
    grid-area: h;
    text-align: right;
    font-family: var(--font-display); font-size: 22px; line-height: 1;
    color: var(--color-ink);
    white-space: nowrap;
  }

  .posuvnik {
    grid-area: p;
    --plneni: 0%;
    width: 100%;
    height: 28px;
    margin: 0;
    background: transparent;
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
  }
  .posuvnik::-webkit-slider-runnable-track {
    height: 8px;
    background: linear-gradient(90deg, var(--color-pirate) var(--plneni), var(--color-mist) var(--plneni));
  }
  .posuvnik::-moz-range-track { height: 8px; background: var(--color-mist); }
  .posuvnik::-moz-range-progress { height: 8px; background: var(--color-pirate); }
  .posuvnik::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 24px; height: 24px;
    margin-top: -8px;
    background: var(--color-paper);
    border: 3px solid var(--color-pirate-dark);
    border-radius: 50%;
  }
  .posuvnik::-moz-range-thumb {
    width: 18px; height: 18px;
    background: var(--color-paper);
    border: 3px solid var(--color-pirate-dark);
    border-radius: 50%;
  }
  .posuvnik:focus-visible { outline: 2px solid var(--color-pirate-dark); outline-offset: 4px; }

  .ucast {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: "l h" "p p";
    align-items: center;
    row-gap: 8px;
    max-width: 480px;
  }
  .ucast .pole-label { grid-area: l; margin: 0; }

  .soucet {
    padding: 10px 14px;
    font-family: var(--font-mono);
    font-size: 13px;
    background-color: var(--color-spa-stone);
    border: 1px solid var(--color-mist);
