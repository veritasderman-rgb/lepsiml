---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import PillarStrip from "../components/PillarStrip.astro";
import LeaderCard from "../components/LeaderCard.astro";
import FeatureCard from "../components/FeatureCard.astro";
import MeetingList from "../components/MeetingList.astro";
import { whyUs } from "../lib/site";
import { Icon } from "astro-icon/components";

// Dočasně skryté sekce — zapnout přepnutím na true, až bude obsah ready.
const SHOW_MEETINGS_TEASER = false;
const SHOW_PODCAST_TEASER = false;
---

<Base
  title="Za lepší Mariánské Lázně"
  description="Komunální volby 2026 v Mariánských Lázních. Lídr Vojta Franta a tým Za lepší Mariánské Lázně. Dotáhneme radnici, otevřeme ji lidem, zajistíme kulturu celý rok."
>
  <Hero />

  <!-- Odpočítávání do komunálních voleb 2026 -->
  <section
    class="relative overflow-hidden"
    style="background: var(--color-ink);"
    aria-label="Odpočítávání do komunálních voleb 2026"
  >
    <span
      class="hero-shape"
      style="width: 600px; height: 600px; top: -200px; right: -200px;"
      aria-hidden="true"
    ></span>
    <div class="container-site relative" style="padding-block: 64px 72px;">
      <div class="text-center">
        <p class="eyebrow" style="color: var(--color-pirate-light);">
          Komunální volby 2026
        </p>
        <p
          class="mt-3 text-lg"
          style="color: var(--color-mist); font-family: var(--font-body);"
        >
          Do voleb zbývá
        </p>
        <div
          id="election-countdown"
          class="mt-6 flex flex-wrap justify-center items-start gap-2"
          aria-live="polite"
          aria-atomic="true"
        >
          <div class="countdown-unit">
            <span id="cd-days" class="countdown-num">–</span>
            <span class="countdown-label">dní</span>
          </div>
          <div class="countdown-sep" aria-hidden="true">:</div>
          <div class="countdown-unit">
            <span id="cd-hours" class="countdown-num">–</span>
            <span class="countdown-label">hodin</span>
          </div>
          <div class="countdown-sep" aria-hidden="true">:</div>
          <div class="countdown-unit">
            <span id="cd-minutes" class="countdown-num">–</span>
            <span class="countdown-label">minut</span>
          </div>
          <div class="countdown-sep" aria-hidden="true">:</div>
          <div class="countdown-unit">
            <span id="cd-seconds" class="countdown-num">–</span>
            <span class="countdown-label">sekund</span>
          </div>
        </div>
        <p class="mt-6 text-sm" style="color: rgba(255,255,255,0.35);">
          Pátek 23. října 2026 — otevření volebních místností
        </p>
      </div>
    </div>
  </section>

  <PillarStrip />
  <LeaderCard />

  <!-- Proč my -->
  <section
    class="section"
    style="background-color: var(--color-cream);"
    aria-labelledby="why-heading"
  >
    <div class="container-site">
      <div class="max-w-2xl">
        <p class="eyebrow">Proč my</p>
        <h2 id="why-heading" class="mt-3">Máme výsledky, ne sliby</h2>
        <p class="mt-4 text-lg" style="color: var(--color-smoke);">
          Mariánské Lázně za naší éry na radnici získaly to, o čem jiní jen
          mluví. Tři konkrétní věci, tři roky, tři doklady — ne marketingové
          fráze.
        </p>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {
          whyUs.map((item, i) => (
            <FeatureCard
              icon={item.icon}
              year={item.year}
              title={item.title}
              body={item.body}
              accent={i === 0 ? "accent" : "primary"}
            />
          ))
        }
      </div>
    </div>
  </section>

  {SHOW_MEETINGS_TEASER && (
    <section class="section" aria-labelledby="meetings-teaser">
      <div class="container-site">
        <div class="grid gap-10 lg:grid-cols-[1fr_1.4fr] items-start">
          <div>
            <p class="eyebrow">Potkejme se</p>
            <h2 id="meetings-teaser" class="mt-3">Přijdeme za vámi do čtvrti</h2>
            <p class="mt-4 text-lg" style="color: var(--color-smoke);">
              Program se nedělá v kanceláři. Chceme slyšet, co vás trápí,
              co chybí, co funguje. Proto pravidelně vyrazíme za lidmi —
              ne jednou za čtyři roky, ale průběžně.
            </p>
            <div class="mt-8">
              <a href="/setkani" class="btn btn-primary">
                <Icon name="lucide:calendar-days" width={18} height={18} />
                Všechna setkání
              </a>
            </div>
          </div>
          <div>
            <MeetingList limit={2} />
          </div>
        </div>
      </div>
    </section>
  )}

  {SHOW_PODCAST_TEASER && (
  <section
    class="section relative overflow-hidden"
    style="background-color: var(--color-ink); margin-top: 0;"
    aria-labelledby="podcast-teaser"
  >
    <span
      class="hero-shape"
      style="width: 500px; height: 500px; top: -160px; right: -140px;"
      aria-hidden="true"></span>

    <div class="container-site relative">
      <div class="grid gap-10 md:grid-cols-[1.2fr_1fr] items-center">
        <div>
          <p class="eyebrow" style="color: var(--color-pirate-light);">Podcast</p>
          <h2 id="podcast-teaser" class="mt-3" style="color: var(--color-paper);">
            Ze sklepa — upřímně o Mariánkách
          </h2>
          <p class="mt-5 text-lg max-w-xl" style="color: var(--color-mist);">
            Mluvíme o tom, co Mariánky trápí, co funguje a co bychom udělali
            jinak. Žádná propaganda — upřímné rozhovory s lidmi, kterým
            na městě záleží.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/podcast" class="btn btn-primary">
              <Icon name="lucide:headphones" width={18} height={18} />
              Přejít na podcast
            </a>
            <a href="/program" class="btn btn-outline">Náš program</a>
          </div>
        </div>
        <div
          class="reveal card"
          style="background-color: rgba(255,255,255,0.04); border-color: rgba(255,255,255,0.14);"
        >
          <div class="flex items-center gap-4">
            <span
              class="icon-badge icon-badge-lg"
              style="background-color: rgba(0,178,169,0.14); color: var(--color-pirate);"
              aria-hidden="true"
            >
              <Icon name="lucide:mic" width={34} height={34} />
            </span>
            <div>
              <p class="eyebrow" style="color: var(--color-pirate);">
                Nový díl
              </p>
              <h3
                class="mt-1"
                style="font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.02em; color: var(--color-paper); font-size: 1.5rem;"
              >
                Připravujeme první rozhovory
              </h3>
            </div>
          </div>
          <p class="mt-5 text-[15px]" style="color: rgba(255,255,255,0.8);">
            První díly představí kandidátku a její vizi. Sledujte Spotify,
            Apple Podcasts nebo YouTube.
          </p>
        </div>
      </div>
    </div>
  </section>
  )}
</Base>

<script>
  (function () {
    // Komunální volby 2026 — pátek 23. října 2026, 14:00 (otevření místností)
    const ELECTION = new Date("2026-10-23T14:00:00").getTime();

    function pad(n: number): string {
      return String(n).padStart(2, "0");
    }

    function tick() {
      const diff = ELECTION - Date.now();
      if (diff <= 0) {
        const el = document.getElementById("election-countdown");
        if (el) {
          el.innerHTML =
            '<p style="font-family:var(--font-display);text-transform:uppercase;letter-spacing:0.02em;color:var(--color-pirate);font-size:2.5rem;">Volby právě probíhají!</p>';
        }
        return;
      }

      const totalSec = Math.floor(diff / 1000);
      const days = Math.floor(totalSec / 86400);
      const hours = Math.floor((totalSec % 86400) / 3600);
      const minutes = Math.floor((totalSec % 3600) / 60);
      const seconds = totalSec % 60;

      const dEl = document.getElementById("cd-days");
      const hEl = document.getElementById("cd-hours");
      const mEl = document.getElementById("cd-minutes");
      const sEl = document.getElementById("cd-seconds");

      if (dEl) dEl.textContent = String(days);
      if (hEl) hEl.textContent = pad(hours);
      if (mEl) mEl.textContent = pad(minutes);
      if (sEl) sEl.textContent = pad(seconds);
    }

    tick();
    setInterval(tick, 1000);
  })();
</script>
