---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import PillarStrip from "../components/PillarStrip.astro";
import LeaderCard from "../components/LeaderCard.astro";
import Kresla from "../components/Kresla.astro";
import { Icon } from "astro-icon/components";
import { site } from "../lib/site";
import { datum, nactiAktuality } from "../lib/aktuality";
import {
  MANDATU,
  cislo,
  mandatu,
  nas,
  nasZastupitel,
  pct,
  prehled,
  vysledky,
  vysledkyPodlePoradi,
} from "../lib/volby2026";

const aktuality = (await nactiAktuality()).slice(0, 3);
const mandaty = Object.fromEntries(vysledky.map((v) => [v.cislo, v.mandaty]));
const vZastupitelstvu = vysledkyPodlePoradi.filter((v) => v.mandaty > 0);
---

<Base
  fullTitle={`${site.name} — Mariánské Lázně 2026–2030`}
  description={`Děkujeme za ${cislo(nas.hlasy)} hlasů. Zastupitelem za Za lepší Mariánské Lázně se stal ${nasZastupitel.jmeno}. Náš plán pro Mariánské Lázně 2026–2030 a zprávy z jednání o koalici.`}
>
  <Hero
    label="Komunální volby 2026 · Děkujeme"
    headline="Děkujeme, Mariánky!"
    subheadline={`${cislo(nas.hlasy)} hlasů a mandát pro Vojtu Frantu. V zastupitelstvu budeme prosazovat to, co jsme vám slíbili.`}
    primaryCta={{ label: "Plán 2026–2030", href: "/plan-1155/" }}
    secondaryCta={{ label: "Výsledky voleb", href: "/vysledky-voleb" }}
  />

  <!-- Výsledek voleb -->
  <section
    class="relative overflow-hidden"
    style="background: var(--color-ink);"
    aria-labelledby="vysledek-heading"
  >
    <span
      class="hero-shape"
      style="width: 600px; height: 600px; top: -200px; right: -200px;"
      aria-hidden="true"
    ></span>
    <div class="container-site relative" style="padding-block: 72px;">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr] items-start">
        <div>
          <p class="eyebrow" style="color: var(--color-pirate-light);">
            Výsledek voleb 9.–10. října 2026
          </p>
          <h2 id="vysledek-heading" class="mt-3" style="color: var(--color-paper);">
            Máme zastupitele
          </h2>
          <p class="mt-5 text-lg" style="color: var(--color-mist);">
            Kandidátka Za lepší Mariánské Lázně dostala
            <strong style="color: var(--color-paper);">{cislo(nas.hlasy)} hlasů ({pct(nas.procent, 2)})</strong>
            a {mandatu(nas.mandaty)}. Zastupitelem se stává
            <strong style="color: var(--color-paper);">{nasZastupitel.jmeno}</strong>,
            jednička naší kandidátky, s {cislo(nasZastupitel.prednostniHlasy)} přednostními hlasy.
            Volební účast byla {pct(prehled.ucast, 2)}.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/vysledky-voleb" class="btn btn-primary">Všechny výsledky</a>
            <a href="/vysledky-voleb#tipy" class="btn btn-outline">Jak jste tipovali</a>
          </div>
        </div>

        <div>
          <p class="mono-meta" style="color: var(--color-pirate-light);">
            Zastupitelstvo 2026–2030 · {MANDATU} mandátů
          </p>
          <div class="mt-4">
            <Kresla
              dark
              mandaty={mandaty}
              label={vZastupitelstvu.map((v) => `${v.nazev}: ${mandatu(v.mandaty)}`).join(", ")}
            />
          </div>
          <ul class="mt-6 grid gap-1.5 text-[15px]">
            {
              vZastupitelstvu.map((v) => (
                <li class="flex items-baseline gap-3" style={`color: ${v.nase ? "var(--color-pirate-light)" : "var(--color-mist)"};`}>
                  <span class="w-6 shrink-0 text-right" style="font-family: var(--font-display); font-size: 18px;">
                    {v.cislo}
                  </span>
                  <span class="flex-1">{v.nazev}</span>
                  <span class="shrink-0 whitespace-nowrap" style={v.nase ? "font-weight: 700;" : ""}>
                    {pct(v.procent)} · {mandatu(v.mandaty)}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <LeaderCard
    eyebrow="Náš zastupitel 2026–2030"
    role="Zastupitel města Mariánské Lázně · jednička kandidátky Za lepší Mariánské Lázně"
    cta={{ label: "Co bude prosazovat", href: "/program" }}
  />

  <!-- Aktuality: jednání o koalici a práce v zastupitelstvu -->
  <section
    class="section"
    style="background-color: var(--color-off-white);"
    aria-labelledby="aktuality-heading"
  >
    <div class="container-site">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl">
          <p class="eyebrow">Co bude dál</p>
          <h2 id="aktuality-heading" class="mt-3">Aktuality</h2>
          <p class="mt-4 text-lg" style="color: var(--color-smoke);">
            Teď se jedná o tom, kdo povede město. Jak se daří vyjednat
            koalici a co prosazujeme v zastupitelstvu, budeme psát tady.
          </p>
        </div>
        <a href="/aktuality" class="btn btn-ghost">
          Všechny aktuality
          <Icon name="lucide:arrow-right" width={16} height={16} />
        </a>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          aktuality.map((a) => (
            <a
              href={`/aktuality/${a.id}`}
              class="reveal card card-hover flex flex-col"
              style="border-top: 4px solid var(--color-pirate);"
            >
              <p class="mono-meta" style="color: var(--color-pirate-dark);">
                {a.data.tag} · {datum(a.data.date)}
              </p>
              <h3 class="mt-2 aktualita-title">{a.data.title}</h3>
              <p class="mt-3 text-[15px]" style="color: var(--color-smoke);">{a.data.perex}</p>
              <span class="mt-auto pt-5 inline-flex items-center gap-1 mono-meta" style="color: var(--color-pirate);">
                Číst
                <Icon name="lucide:arrow-right" width={16} height={16} />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <PillarStrip
    eyebrow="Plán pro Mariánské Lázně 2026–2030"
    heading="Šest priorit, které budeme prosazovat"
    intro="Tohle jsme vám slíbili před volbami a za tím si stojíme: dotáhnout radnici, podpořit rodiny, využít potenciál UNESCO, otevřít úřad lidem, udržitelné Mariánky a dostupnější zdravotní péči."
  />

  <!-- Mariánky 10X lépe — konkrétní projekty na 2026–2030 -->
  <section
    class="relative overflow-hidden"
    style="background-color: var(--color-ink);"
    aria-labelledby="plan1155-heading"
  >
    <span
      class="hero-shape"
      style="width: 520px; height: 520px; top: -180px; right: -160px;"
      aria-hidden="true"
    ></span>
    <div
      class="container-site relative"
      style="padding-block: 72px;"
    >
      <div class="grid gap-10 lg:grid-cols-[1.3fr_1fr] items-center">
        <div>
          <p class="eyebrow" style="color: var(--color-pirate-light);">
            Od priorit ke konkrétním projektům
          </p>
          <h2 id="plan1155-heading" class="mt-3" style="color: var(--color-paper);">
            Mariánky 10X lépe
          </h2>
          <p class="mt-5 text-lg max-w-xl" style="color: var(--color-mist);">
            Priority výše převádíme do praxe:
            <strong style="color: var(--color-paper);">10 konkrétních projektů pro Mariánské Lázně 2026–2030</strong>,
            financovaných z evropských a národních fondů. Na nich budeme
            v zastupitelstvu pracovat a o pokroku psát v Aktualitách.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/plan-1155/" class="btn btn-primary">
              Zobrazit projekty →
            </a>
            <a href="/program" class="btn btn-outline">Celý program</a>
          </div>
        </div>
        <div
          class="reveal"
          style="border: 1px solid rgba(255,255,255,0.14); border-radius: 0; padding: 28px; background-color: rgba(255,255,255,0.04);"
        >
          <p
            class="mono-meta"
            style="color: var(--color-pirate-light);"
          >
            10 projektů · 2026–2030
          </p>
          <p
            class="mt-3"
            style="font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.02em; color: var(--color-paper); font-size: clamp(2rem, 4vw, 3rem); line-height: 1;"
          >
            1,25–1,8 mld. Kč
          </p>
          <p class="mt-2 text-sm" style="color: var(--color-mist);">
            investic, z toho 70–85 % z externího financování. Cíl: 15 500 obyvatel
            do roku 2035 — řízený růst, ne údržba úpadku.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Archiv kampaně -->
  <section class="section" aria-labelledby="archiv-heading">
    <div class="container-site">
      <div class="card flex flex-col md:flex-row md:items-center justify-between gap-6" style="border-left: 4px solid var(--color-spa-gold);">
        <div class="max-w-2xl">
          <p class="eyebrow" style="color: #8a6420;">Archiv</p>
          <h2 id="archiv-heading" class="mt-2 archiv-title">Kampaň 2026</h2>
          <p class="mt-3 text-[16px]" style="color: var(--color-smoke);">
            Kandidátka, dotazník, hlasovací lístek nanečisto, tipovačka
            i přehled toho, co jsme na radnici dokázali. Všechno z kampaně
            zůstává k dispozici.
          </p>
        </div>
        <a href="/archiv" class="btn btn-ghost shrink-0">
          Archiv kampaně
          <Icon name="lucide:arrow-right" width={16} height={16} />
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .aktualita-title {
    font-size: 1.75rem;
  }
  .archiv-title {
    font-size: 2rem;
  }
</style>
