---
import Base from "../layouts/Base.astro";
import { Icon } from "astro-icon/components";
import { contact } from "../lib/site";
import {
  SURVEY_MAX_PROBLEMS,
  surveyConsent,
  surveyContactOptions,
  surveyDisclaimer,
  surveyFormUrl,
  surveyMeta,
  surveyPdf,
  surveyProblems,
  surveyProjects,
  surveyPromises,
  surveyScale,
} from "../lib/survey";

// Dokud není hotový online formulář ani tisková verze s doplněným IČO,
// nenabízíme mrtvá tlačítka.
const online = surveyFormUrl.length > 0;
const pdfReady = surveyPdf.length > 0;
---

<Base title={surveyMeta.title} description={surveyMeta.intro}>
  <!-- ============ HERO ============ -->
  <section
    class="relative overflow-hidden"
    style="background: linear-gradient(135deg, #000000 0%, #0a1f1d 100%);"
    aria-labelledby="dotaznik-heading"
  >
    <span
      class="hero-shape"
      style="width: 500px; height: 500px; top: -190px; right: -150px;"
      aria-hidden="true"></span>
    <div class="container-site relative py-20 md:py-28">
      <p class="eyebrow" style="color: var(--color-pirate-light);">
        Ptáme se lidí, kteří tu žijí
      </p>
      <h1 id="dotaznik-heading" class="reveal mt-4" style="color: var(--color-paper);">
        {surveyMeta.lead}
      </h1>
      <p
        class="reveal mt-6 text-lg md:text-xl max-w-2xl"
        style="color: var(--color-mist);"
      >
        {surveyMeta.intro}
      </p>

      <p class="reveal mono-meta mt-6 flex items-center gap-2" style="color: var(--color-pirate-light);">
        <Icon name="lucide:clock" width={15} height={15} aria-hidden="true" />
        {surveyMeta.duration}
      </p>

      <div class="mt-10 flex flex-wrap gap-3">
        {
          online ? (
            <a href={surveyFormUrl} target="_blank" rel="noopener" class="btn btn-primary">
              Vyplnit online →
            </a>
          ) : (
            <span class="btn" style="background-color: rgba(255,255,255,0.08); color: var(--color-mist); border-color: rgba(255,255,255,0.2); cursor: default;">
              Online formulář připravujeme
            </span>
          )
        }
        {
          pdfReady && (
            <a href={surveyPdf} class="btn btn-outline" download>
              Stáhnout k tisku (PDF)
            </a>
          )
        }
      </div>
    </div>
  </section>

  <!-- ============ NA CO SE PTÁME ============ -->
  <section class="section" style="background-color: var(--color-spa-stone);">
    <div class="container-site">
      <div class="max-w-2xl">
        <p class="eyebrow">Na co se ptáme</p>
        <h2 class="mt-3">Tři otázky, tři minuty</h2>
        <p class="mt-4 text-lg" style="color: var(--color-smoke);">
          Než dotazník vyplníte, můžete si projít, na co se ptáme. Nic víc
          v něm není — na volební preference ani politickou orientaci se
          neptáme.
        </p>
      </div>

      <!-- Otázka 1 -->
      <div class="reveal card mt-10" style="background-color: var(--color-paper);">
        <p class="mono-meta" style="color: var(--color-pirate-dark);">Otázka 1</p>
        <h3 class="mt-3 q-title">Co vás v Mariánských Lázních nejvíce trápí?</h3>
        <p class="mt-2" style="color: var(--color-smoke);">
          Vyberte maximálně {SURVEY_MAX_PROBLEMS} odpovědi.
        </p>
        <ul class="opt-grid mt-6">
          {surveyProblems.map((p) => <li class="opt">{p}</li>)}
          <li class="opt opt-other">Jiné — vlastními slovy</li>
        </ul>
      </div>

      <!-- Otázka 2 -->
      <div class="reveal card mt-6" style="background-color: var(--color-paper);">
        <p class="mono-meta" style="color: var(--color-pirate-dark);">Otázka 2</p>
        <h3 class="mt-3 q-title">
          Jak důležité jsou podle vás následující projekty pro budoucnost
          Mariánských Lázní?
        </h3>
        <p class="mt-2" style="color: var(--color-smoke);">
          U každého projektu vyberete jedno číslo. Není vám některý projekt
          jasný? Zeptejte se nás, rádi ho vysvětlíme.
        </p>

        <ol class="scale-legend mt-5">
          {
            surveyScale.map((s) => (
              <li>
                <span class="scale-num">{s.value}</span>
                {s.label}
              </li>
            ))
          }
        </ol>

        <div class="mt-8 grid gap-5 md:grid-cols-2">
          {
            surveyProjects.map((p) => (
              <div class="proj">
                <p class="proj-num">{p.id}</p>
                <p class="proj-title">{p.title}</p>
                <p class="proj-desc">{p.description}</p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Otázka 3 -->
      <div class="reveal card mt-6" style="background-color: var(--color-paper); border-left: 4px solid var(--color-spa-gold);">
        <p class="mono-meta" style="color: var(--color-pirate-dark);">Otázka 3</p>
        <h3 class="mt-3 q-title">
          Kdybyste mohl/a v Mariánských Lázních změnit jednu věc, co by to
          bylo?
        </h3>
        <p class="mt-2" style="color: var(--color-smoke);">
          Vlastními slovy. Zajímá nás i to, co jsme do dotazníku nezařadili —
          tahle odpověď je pro nás nejcennější.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ KONTAKT / SOUHLAS ============ -->
  <section class="section" aria-labelledby="kontaktni-blok">
    <div class="container-site">
      <div class="grid gap-10 lg:grid-cols-[1.2fr_1fr]">
        <div>
          <p class="eyebrow">Nepovinná část</p>
          <h2 id="kontaktni-blok" class="mt-3">Chcete zůstat v kontaktu?</h2>
          <p class="mt-4 text-lg" style="color: var(--color-smoke);">
            Kontakt je dobrovolný. Dotazník je bez něj stejně platný — nic se
            tím neztrácí a nikomu se nic neposílá.
          </p>
          <ul class="mt-6 grid gap-3">
            {
              surveyContactOptions.map((o) => (
                <li class="opt">{o.label}</li>
              ))
            }
          </ul>
        </div>

        <aside class="card" style="background-color: var(--color-cream); align-self: start;">
          <p class="mono-meta" style="color: var(--color-pirate-dark);">
            Jak nakládáme s údaji
          </p>
          <p class="mt-3 text-[14px]" style="color: var(--color-graphite); line-height: 1.6;">
            {surveyConsent}
          </p>
        </aside>
      </div>
    </div>
  </section>

  <!-- ============ CO S ODPOVĚĎMI ============ -->
  <section class="section" style="background-color: var(--color-ink);">
    <div class="container-site">
      <p class="eyebrow" style="color: var(--color-pirate-light);">Slibujeme</p>
      <h2 class="mt-3" style="color: var(--color-paper);">
        Co s odpověďmi uděláme
      </h2>

      <ul class="mt-8 grid gap-4 md:grid-cols-2 max-w-4xl">
        {
          surveyPromises.map((p) => (
            <li class="promise">{p}</li>
          ))
        }
      </ul>

      <div class="mt-10 flex flex-wrap gap-3">
        {
          online && (
            <a href={surveyFormUrl} target="_blank" rel="noopener" class="btn btn-primary">
              Vyplnit online →
            </a>
          )
        }
        <a href={`mailto:${contact.email}`} class="btn btn-outline">
          Mám otázku k projektu
        </a>
      </div>

      <p class="mt-10 text-[13px] max-w-3xl" style="color: var(--color-ash); line-height: 1.6;">
        {surveyDisclaimer}
      </p>
    </div>
  </section>
</Base>

<style>
  .q-title {
    font-family: var(--font-body);
    font-weight: 700;
    text-transform: none;
    letter-spacing: -0.01em;
    font-size: clamp(1.25rem, 1.5vw + 0.875rem, 1.625rem);
    line-height: 1.25;
    color: var(--color-ink);
  }

  .opt-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  @media (min-width: 768px) {
    .opt-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .opt {
    position: relative;
    padding: 12px 14px 12px 44px;
    background-color: var(--color-cream);
    border: 1px solid var(--color-mist);
    color: var(--color-graphite);
    font-size: 15px;
    line-height: 1.4;
    list-style: none;
  }

  /* Prázdné zaškrtávátko — stránka je náhled tištěného dotazníku. */
  .opt::before {
    content: "";
    position: absolute;
    left: 14px;
    top: 13px;
    width: 18px;
    height: 18px;
    border: 2px solid var(--color-pirate);
    background-color: var(--color-paper);
  }

  .opt-other {
    font-style: italic;
    color: var(--color-smoke);
  }

  .scale-legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    font-size: 14px;
    color: var(--color-smoke);
  }

  .scale-legend li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .scale-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    background-color: var(--color-spa-stone);
    border: 1px solid var(--color-mist);
    font-family: var(--font-display);
    font-size: 15px;
    line-height: 1;
    color: var(--color-ink);
  }

  .proj {
    border-left: 3px solid var(--color-pirate);
    padding-left: 16px;
  }

  .proj-num {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--color-pirate-dark);
  }

  .proj-title {
    font-weight: 700;
    font-size: 17px;
    line-height: 1.3;
    color: var(--color-ink);
    margin-top: 3px;
  }

  .proj-desc {
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--color-smoke);
    margin-top: 5px;
  }

  .promise {
    list-style: none;
    padding: 18px 20px;
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-left: 3px solid var(--color-pirate);
    color: var(--color-mist);
    font-size: 15px;
    line-height: 1.55;
  }
</style>
