---
import Base from "../../layouts/Base.astro";
import { Icon } from "astro-icon/components";
import { render } from "astro:content";
import { datum, nactiAktuality, type Aktualita } from "../../lib/aktuality";

export async function getStaticPaths() {
  const aktuality = await nactiAktuality();
  return aktuality.map((a) => ({ params: { id: a.id }, props: { aktualita: a } }));
}

const { aktualita } = Astro.props as { aktualita: Aktualita };
const { Content } = await render(aktualita);
const { title, date, perex, tag } = aktualita.data;
---

<Base title={title} description={perex}>
  <article>
    <header
      class="relative overflow-hidden"
      style="background: linear-gradient(135deg, #000000 0%, #0a1f1d 100%);"
    >
      <span
        class="hero-shape"
        style="width: 500px; height: 500px; top: -190px; right: -150px;"
        aria-hidden="true"></span>
      <div class="container-site relative py-16 md:py-20 max-w-3xl">
        <p class="eyebrow" style="color: var(--color-pirate-light);">
          {tag} · <time datetime={date.toISOString().slice(0, 10)}>{datum(date)}</time>
        </p>
        <h1 class="mt-4 clanek-h1" style="color: var(--color-paper);">{title}</h1>
        <p class="mt-6 text-lg md:text-xl" style="color: var(--color-mist);">{perex}</p>
      </div>
    </header>

    <div class="section">
      <div class="container-site max-w-3xl">
        <div class="clanek">
          <Content />
        </div>
        <a
          href="/aktuality"
          class="mt-12 inline-flex items-center gap-2"
          style="font-weight: 700; color: var(--color-pirate-dark);"
        >
          <Icon name="lucide:arrow-left" width={18} height={18} />
          Všechny aktuality
        </a>
      </div>
    </div>
  </article>
</Base>

<style>
  .clanek-h1 {
    font-size: clamp(2.5rem, 4vw + 1rem, 4rem);
  }
  .clanek {
    font-size: 18px;
    line-height: 1.7;
    color: var(--color-graphite);
  }
  .clanek :global(p),
  .clanek :global(ul),
  .clanek :global(ol) {
    margin-top: 1.1em;
  }
  .clanek :global(> :first-child) {
    margin-top: 0;
  }
  .clanek :global(h2) {
    margin-top: 1.8em;
    font-size: clamp(1.75rem, 1.5vw + 1rem, 2.25rem);
  }
  .clanek :global(h3) {
    margin-top: 1.5em;
    font-size: 1.5rem;
  }
  .clanek :global(ul) {
    list-style: disc;
    padding-left: 1.4em;
  }
  .clanek :global(ol) {
    list-style: decimal;
    padding-left: 1.4em;
  }
  .clanek :global(a) {
    text-decoration: underline;
  }
  .clanek :global(strong) {
    color: var(--color-ink);
  }
  .clanek :global(blockquote) {
    margin-top: 1.4em;
    padding-left: 1.2em;
    border-left: 4px solid var(--color-pirate);
    font-family: var(--font-accent);
    font-style: italic;
    font-size: 1.35em;
    color: var(--color-ink);
  }
</style>
