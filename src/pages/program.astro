---
import Base from "../layouts/Base.astro";
import ProgramTopic from "../components/ProgramTopic.astro";
import HealthcareSection from "../components/HealthcareSection.astro";
import { Icon } from "astro-icon/components";
import { programTopics, quickWins } from "../lib/site";
---

<Base
  title="Program"
  description="Program kandidátky Za lepší Mariánské Lázně pro komunální volby 2026 — pět pilířů: hrdé město, rodiny a mladí, UNESCO destinace, otevřená radnice, udržitelné Mariánky."
>
  <!-- Intro -->
  <section
    class="section relative overflow-hidden"
    style="background: linear-gradient(135deg, var(--color-dark) 0%, var(--color-primary) 100%);"
  >
    <span
      class="hero-shape"
      style="width: 480px; height: 480px; top: -180px; right: -140px;"
      aria-hidden="true"></span>
    <div class="container-site relative">
      <p class="eyebrow">Náš program</p>
      <h1 class="reveal mt-4" style="color: #fff; max-width: 22ch;">
        Pět pilířů pro lepší Mariánky
      </h1>
      <p
        class="reveal mt-6 text-lg md:text-xl max-w-2xl"
        style="color: var(--color-primary-pale);"
      >
        Program není seznam přání. Je to plán, jak dotáhnout věci, které
        Mariánky potřebují — rozpočtově zodpovědně, s jasným financováním
        a v reálném čase.
      </p>
    </div>
  </section>

  <!-- Topics -->
  <section class="section" style="background-color: var(--color-off-white);">
    <div class="container-site">
      <div class="grid gap-10">
        {programTopics.map((topic) => <ProgramTopic topic={topic} />)}
      </div>
    </div>
  </section>

  <!-- Healthcare -->
  <HealthcareSection />

  <!-- Quick wins -->
  <section class="section" style="background-color: var(--color-primary-bg);" aria-labelledby="quick-wins">
    <div class="container-site">
      <div class="max-w-2xl">
        <p class="eyebrow" style="color: var(--color-primary);">Do 100 dnů</p>
        <h2 id="quick-wins" class="mt-3">Quick wins — co uděláme hned</h2>
        <p class="mt-4 text-lg" style="color: var(--color-text-light);">
          Prvních 100 dnů po volbách rozhodne, zda věříme vlastnímu programu.
          Tady je pět věcí, které spustíme okamžitě.
        </p>
      </div>

      <ol class="mt-10 grid gap-4 md:grid-cols-2">
        {
          quickWins.map((win, i) => (
            <li
              class="reveal card flex gap-4 items-start"
              style="background-color: #fff;"
            >
              <span
                class="icon-badge shrink-0"
                style="color: var(--color-accent); background-color: var(--color-accent-light);"
                aria-hidden="true"
              >
                <Icon name="lucide:clock" width={24} height={24} />
              </span>
              <div>
                <p
                  class="text-sm font-bold uppercase tracking-[0.15em]"
                  style="color: var(--color-primary);"
                >
                  Krok {i + 1}
                </p>
                <p class="mt-1 text-[17px]" style="color: var(--color-dark);">
                  {win}
                </p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="mt-14 text-center">
        <a href="/kandidati" class="btn btn-primary">
          Poznejte kandidáty
        </a>
      </div>
    </div>
  </section>
</Base>
