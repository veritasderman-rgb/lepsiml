---
import Base from "../layouts/Base.astro";
import ProgramTopic from "../components/ProgramTopic.astro";
import { Icon } from "astro-icon/components";
import { programTopics, quickWins } from "../lib/site";
---

<Base
  title="Program"
  description="Program kandidátky Za lepší Mariánské Lázně pro komunální volby 2026 — šest pilířů: hrdé město, rodiny a mladí, UNESCO destinace, otevřená radnice, udržitelné Mariánky, zdravotnictví."
>
  <!-- Intro -->
  <section
    class="section relative overflow-hidden"
    style="background: linear-gradient(135deg, #000000 0%, #0a1f1d 100%);"
  >
    <span
      class="hero-shape"
      style="width: 480px; height: 480px; top: -180px; right: -140px;"
      aria-hidden="true"></span>
    <div class="container-site relative">
      <p class="eyebrow" style="color: var(--color-pirate-light);">Náš program</p>
      <h1 class="reveal mt-4" style="color: var(--color-paper); max-width: 22ch;">
        Šest pilířů pro lepší Mariánky
      </h1>
      <p
        class="reveal mt-6 text-lg md:text-xl max-w-2xl"
        style="color: var(--color-mist);"
      >
        Program není seznam přání. Je to plán, jak dotáhnout věci, které
        Mariánky potřebují — rozpočtově zodpovědně, s jasným financováním
        a v reálném čase.
      </p>
    </div>
  </section>

  <!-- Topics -->
  <section class="section" style="background-color: var(--color-off-white);">
    <div class="container-site">
      <div class="grid gap-10">
        {programTopics.map((topic) => <ProgramTopic topic={topic} />)}
      </div>
    </div>
  </section>

  <!-- Hypotéka pro rodiny — samostatný návrh nad rámec šesti pilířů -->
  <section
    class="section"
    style="background-color: var(--color-ink);"
    aria-labelledby="program-hypoteka"
  >
    <div class="container-site">
      <div class="grid gap-8 lg:grid-cols-[1.4fr_auto] items-center">
        <div>
          <p class="eyebrow" style="color: var(--color-spa-gold);">
            Navíc k šesti pilířům
          </p>
          <h2 id="program-hypoteka" class="mt-3" style="color: var(--color-paper);">
            Hypotéka pro rodiny
          </h2>
          <p class="mt-5 text-lg max-w-2xl" style="color: var(--color-mist);">
            Nejkonkrétnější věc, se kterou jdeme do voleb: rodinám se dvěma
            a více dětmi by město hradilo úrok z hypotéky. Má vlastní stránku,
            protože si zaslouží celý propočet — i seznam otázek, které ještě
            řešíme s právníky a daňovými poradci.
          </p>
        </div>
        <a href="/hypoteka" class="btn btn-primary shrink-0">
          Zobrazit návrh →
        </a>
      </div>
    </div>
  </section>

  <!-- Quick wins -->
  <section
    class="section"
    style="background-color: var(--color-spa-stone);"
    aria-labelledby="quick-wins"
  >
    <div class="container-site">
      <div class="max-w-2xl">
        <p class="eyebrow" style="color: var(--color-spa-gold);">Do 100 dnů</p>
        <h2 id="quick-wins" class="mt-3">Quick wins — co uděláme hned</h2>
        <p class="mt-4 text-lg" style="color: var(--color-smoke);">
          Prvních 100 dnů po volbách rozhodne, zda věříme vlastnímu programu.
          Tady je pět věcí, které spustíme okamžitě.
        </p>
      </div>

      <ol class="mt-10 grid gap-4 md:grid-cols-2">
        {
          quickWins.map((win, i) => (
            <li
              class="reveal card flex gap-4 items-start"
              style="background-color: var(--color-paper); border-left: 4px solid var(--color-spa-gold);"
            >
              <span
                class="icon-badge shrink-0"
                style="color: var(--color-spa-gold); background-color: var(--color-paper);"
                aria-hidden="true"
              >
                <Icon name="lucide:clock" width={24} height={24} />
              </span>
              <div>
                <p class="eyebrow" style="color: var(--color-spa-gold);">
                  Krok {i + 1}
                </p>
                <p class="mt-1 text-[17px]" style="color: var(--color-ink);">
                  {win}
                </p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="mt-14 text-center">
        <a href="/kandidati" class="btn btn-primary">
          Poznejte kandidáty
        </a>
      </div>
    </div>
  </section>
</Base>
