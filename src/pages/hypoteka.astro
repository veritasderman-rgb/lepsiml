---
// Neveřejný náhled programu „Bydlím v Mariánkách" pro tým.
//
// Stránka se buildí a je dostupná na přímé URL, ale schválně na ni nikde
// nevede odkaz — není v `nav`, na homepage ani na stránce programu. Nese
// `noindex`. Do robots.txt ji nedávejte: ten je veřejný a `Disallow:
// /hypoteka` by adresu prozradil komukoli, kdo si ho otevře.
//
// Až se stránka bude zveřejňovat: odebrat `noindex`, vrátit odkazy a doplnit
// tlačítko „Sdílet výpočet" u kalkulačky (viz git historie a zadání).

import Base from "../layouts/Base.astro";
import { Icon } from "astro-icon/components";
import HypotekaKalkulacka from "../components/HypotekaKalkulacka.tsx";
import {
  faq,
  hypotekaMeta as meta,
  jakToFunguje,
  judo,
  model,
  osa,
  pilot,
  pribeh,
  problem,
  vyuctovani,
  zaver,
} from "../lib/hypoteka";
---

<Base
  fullTitle={meta.metaTitle}
  description={meta.metaDescription}
  pathname="/hypoteka"
  noindex
>
  <!-- ============ 1 · HERO ============ -->
  <section
    class="relative overflow-hidden"
    style="background: linear-gradient(135deg, #000000 0%, #0a1f1d 100%);"
    aria-labelledby="hero-heading"
  >
    <span
      class="hero-shape"
      style="width: 560px; height: 560px; top: -220px; right: -180px;"
      aria-hidden="true"></span>
    <div class="container-site relative py-20 md:py-28">
      <p class="eyebrow" style="color: var(--color-pirate-light);">
        {meta.program}
      </p>
      <h1 id="hero-heading" class="reveal mt-4" style="color: var(--color-paper); max-width: 16ch;">
        {meta.claim}
      </h1>
      <p class="reveal mt-6 text-lg md:text-xl max-w-2xl" style="color: var(--color-mist);">
        {meta.podtitulek}
      </p>

      <p class="reveal mt-8 max-w-2xl hypo-status">
        <Icon name="lucide:info" width={18} height={18} aria-hidden="true" />
        <span>{meta.status}</span>
      </p>

      <div class="mt-10">
        <a href="#kalkulacka" class="btn btn-primary">{meta.ctaHero}</a>
      </div>

      <p class="mt-8 mono-meta" style="color: var(--color-pirate-light);">
        {meta.kandidatka} · {meta.volby}
      </p>
    </div>
  </section>

  <!-- ============ 2 · PROBLÉM ============ -->
  <section class="section" style="background-color: var(--color-off-white);">
    <div class="container-site">
      <p class="eyebrow" style="color: var(--color-pirate-dark);">{problem.eyebrow}</p>
      <h2 class="mt-3 max-w-3xl">{problem.title}</h2>
      <ul class="mt-10 grid gap-5 md:grid-cols-3">
        {
          problem.vety.map((v) => (
            <li
              class="reveal card"
              style="background-color: var(--color-paper); border-top: 4px solid var(--color-pirate);"
            >
              <p class="text-[17px]" style="color: var(--color-graphite);">{v}</p>
            </li>
          ))
        }
      </ul>
      <p class="reveal mt-10 hypo-zaver">{problem.zaver}</p>
    </div>
  </section>

  <!-- ============ 3 · JAK TO FUNGUJE ============ -->
  <section class="section" style="background-color: var(--color-paper);">
    <div class="container-site">
      <p class="eyebrow" style="color: var(--color-pirate-dark);">{jakToFunguje.eyebrow}</p>
      <h2 class="mt-3">{jakToFunguje.title}</h2>
      <ol class="mt-10 grid gap-6 md:grid-cols-3">
        {
          jakToFunguje.kroky.map((k) => (
            <li class="reveal hypo-krok">
              <span class="hypo-krok-cislo" aria-hidden="true">{k.cislo}</span>
              <p class="mt-4 text-[17px]" style="color: var(--color-graphite);">{k.text}</p>
            </li>
          ))
        }
      </ol>
      <p class="reveal mt-10 hypo-zaver">{jakToFunguje.zaver}</p>
    </div>
  </section>

  <!-- ============ 4 · KALKULAČKA ============ -->
  <section
    id="kalkulacka"
    class="section scroll-mt-24"
    style="background-color: var(--color-off-white);"
    aria-labelledby="kalkulacka-heading"
  >
    <div class="container-site">
      <div class="max-w-2xl">
        <p class="eyebrow" style="color: var(--color-pirate-dark);">Kalkulačka</p>
        <h2 id="kalkulacka-heading" class="mt-3">Spočítejte si to</h2>
        <p class="mt-4 text-lg" style="color: var(--color-smoke);">
          Posuňte hodnoty podle své hypotéky. Výchozí nastavení odpovídá
          rodinnému bytu v Mariánkách.
        </p>
      </div>

      <div class="mt-10 reveal kalk-obal">
        <HypotekaKalkulacka
          client:visible
          stropJistiny={model.stropJistiny}
          rocniStrop={model.rocniStrop}
          vychoziUver={model.vychoziUver}
          vychoziSazba={model.vychoziSazba}
          vychoziSplatnost={model.vychoziSplatnost}
        />
      </div>
    </div>
  </section>

  <!-- ============ 5 · PŘÍBĚH RODINY ============ -->
  <section class="section" style="background-color: var(--color-paper);">
    <div class="container-site">
      <div class="max-w-3xl">
        <p class="eyebrow" style="color: var(--color-pirate-dark);">{pribeh.eyebrow}</p>
        <h2 class="mt-3">{pribeh.title}</h2>
        <div class="mt-8 space-y-5">
          {
            pribeh.odstavce.map((o) => (
              <p class="reveal text-lg" style="color: var(--color-graphite);">{o}</p>
            ))
          }
        </div>
        <p class="reveal mt-10 hypo-zaver">{pribeh.zaver}</p>
      </div>
    </div>
  </section>

  <!-- ============ 6 · VYÚČTOVÁNÍ ============ -->
  <section class="section" style="background-color: var(--color-off-white);">
    <div class="container-site">
      <div class="max-w-3xl">
        <p class="eyebrow" style="color: var(--color-pirate-dark);">{vyuctovani.eyebrow}</p>
        <h2 class="mt-3">{vyuctovani.title}</h2>
        <p class="mt-4 text-lg" style="color: var(--color-smoke);">{vyuctovani.lead}</p>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {
          vyuctovani.karty.map((k) => (
            <article class="reveal card" style="background-color: var(--color-paper);">
              <span
                class="icon-badge"
                style="color: var(--color-pirate-dark); background-color: var(--color-accent-light);"
                aria-hidden="true"
              >
                <Icon name={k.icon} width={22} height={22} />
              </span>
              <h4 class="mt-4">{k.title}</h4>
              <p class="mt-2 text-[15px]" style="color: var(--color-graphite);">{k.body}</p>
            </article>
          ))
        }
      </div>
      <p class="reveal mt-10 hypo-zaver">{vyuctovani.zaver}</p>

      <div class="reveal mt-12 hypo-judo">
        <h3 style="font-size: clamp(1.5rem, 1.5vw + 1rem, 2rem);">{judo.title}</h3>
        <div class="mt-5 space-y-4 max-w-3xl">
          {judo.odstavce.map((o) => <p class="text-[16px]">{o}</p>)}
        </div>
        <p class="mt-6 hypo-judo-zaver">{judo.zaver}</p>
      </div>
    </div>
  </section>

  <!-- ============ 7 · ČASOVÁ OSA ============ -->
  <section
    class="relative overflow-hidden"
    style="background-color: var(--color-ink);"
    aria-labelledby="osa-heading"
  >
    <span
      class="hero-shape"
      style="width: 480px; height: 480px; bottom: -220px; left: -160px;"
      aria-hidden="true"></span>
    <div class="container-site relative" style="padding-block: 72px 80px;">
      <p class="eyebrow" style="color: var(--color-pirate-light);">{osa.eyebrow}</p>
      <h2 id="osa-heading" class="mt-3" style="color: var(--color-paper);">{osa.title}</h2>

      <ol class="mt-10 hypo-osa">
        {
          osa.body.map((b) => (
            <li class="reveal">
              <p class="hypo-osa-datum">
                {b.datum}
                {b.zdroj && <span class="hypo-osa-zdroj">{b.zdroj}</span>}
              </p>
              <p class="hypo-osa-text">{b.text}</p>
            </li>
          ))
        }
        <li class="reveal je-nase">
          <p class="hypo-osa-datum">{osa.nase.datum}</p>
          <p class="hypo-osa-text">{osa.nase.text}</p>
        </li>
      </ol>

      <p class="reveal mt-10 hypo-zaver" style="color: var(--color-paper);">{osa.zaver}</p>
    </div>
  </section>

  <!-- ============ 8 · NABÍDKA STÁTU ============ -->
  <section class="section" style="background-color: var(--color-paper);">
    <div class="container-site">
      <div class="max-w-3xl">
        <p class="eyebrow" style="color: var(--color-pirate-dark);">{pilot.eyebrow}</p>
        <h2 class="mt-3">{pilot.title}</h2>
        <div class="mt-8 space-y-5">
          {
            pilot.odstavce.map((o) => (
              <p class="reveal text-lg" style="color: var(--color-graphite);">{o}</p>
            ))
          }
        </div>
        <p class="reveal mt-10 hypo-zaver">{pilot.zaver}</p>
      </div>
    </div>
  </section>

  <!-- ============ 9 · FAQ ============ -->
  <section class="section" style="background-color: var(--color-off-white);" aria-labelledby="faq-heading">
    <div class="container-site">
      <div class="max-w-2xl">
        <p class="eyebrow" style="color: var(--color-pirate-dark);">Otázky a odpovědi</p>
        <h2 id="faq-heading" class="mt-3">Na co se ptáte</h2>
      </div>
      <div class="mt-10 max-w-3xl">
        {
          faq.map((f) => (
            <details class="accordion">
              <summary>{f.q}</summary>
              <div class="accordion-body">
                <p>{f.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ 10 · ZÁVĚR ============ -->
  <section
    class="relative overflow-hidden"
    style="background: linear-gradient(135deg, #000000 0%, #0a1f1d 100%);"
    aria-labelledby="zaver-heading"
  >
    <span
      class="hero-shape"
      style="width: 520px; height: 520px; top: -200px; right: -160px;"
      aria-hidden="true"></span>
    <div class="container-site relative text-center" style="padding-block: 88px;">
      <h2 id="zaver-heading" class="reveal" style="color: var(--color-paper);">
        {zaver.title}
      </h2>
      <p class="reveal mt-6 text-lg md:text-xl mx-auto" style="color: var(--color-mist); max-width: 46ch;">
        {zaver.body}
      </p>
      <p class="reveal mt-10 hypo-cta">{zaver.cta}</p>
    </div>
  </section>
</Base>

<style>
  .hypo-status {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 16px 18px;
    border-left: 3px solid var(--color-pirate);
    background-color: rgba(0, 178, 168, 0.1);
    color: var(--color-mist);
    font-size: 15px;
  }

  .hypo-status :global(svg) {
    flex-shrink: 0;
    margin-top: 3px;
    color: var(--color-pirate-light);
  }

  /* Věta, kterou si má člověk zapamatovat — jedna na sekci. */
  .hypo-zaver {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.15;
    font-size: clamp(1.5rem, 2.2vw + 0.75rem, 2.25rem);
    color: var(--color-ink);
    border-left: 4px solid var(--color-pirate);
    padding-left: 20px;
    max-width: 24ch;
  }

  .hypo-krok {
    border-top: 2px solid var(--color-pirate);
    padding-top: 20px;
  }

  .hypo-krok-cislo {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    line-height: 1;
    color: var(--color-pirate);
  }

  .hypo-judo {
    background-color: var(--color-ink);
    color: var(--color-mist);
    padding: 32px;
  }

  .hypo-judo h3 {
    color: var(--color-paper);
  }

  .hypo-judo-zaver {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: clamp(1.25rem, 1.5vw + 0.75rem, 1.75rem);
    line-height: 1.2;
    color: var(--color-pirate-light);
  }

  /* ---------- časová osa ---------- */
  .hypo-osa {
    display: grid;
    gap: 0;
    max-width: 780px;
  }

  .hypo-osa li {
    position: relative;
    padding: 20px 0 20px 32px;
    border-left: 2px solid rgba(255, 255, 255, 0.18);
  }

  .hypo-osa li::before {
    content: "";
    position: absolute;
    left: -7px;
    top: 27px;
    width: 12px;
    height: 12px;
    background-color: var(--color-smoke);
  }

  .hypo-osa li.je-nase {
    border-left-color: var(--color-pirate);
  }

  .hypo-osa li.je-nase::before {
    background-color: var(--color-pirate);
  }

  .hypo-osa-datum {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ash);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .hypo-osa li.je-nase .hypo-osa-datum {
    color: var(--color-pirate-light);
  }

  .hypo-osa-zdroj {
    border: 1px solid rgba(255, 255, 255, 0.24);
    padding: 2px 7px;
    letter-spacing: 0.08em;
  }

  .hypo-osa-text {
    margin-top: 10px;
    font-size: 16px;
    color: var(--color-mist);
  }

  .hypo-osa li.je-nase .hypo-osa-text {
    color: var(--color-paper);
  }

  .hypo-cta {
    display: inline-block;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: clamp(1.5rem, 2.5vw + 0.75rem, 2.5rem);
    line-height: 1.1;
    color: var(--color-ink);
    background-color: var(--color-pirate);
    padding: 16px 28px;
  }

  /* ---------- kalkulačka (kořen renderuje React, proto :global) ---------- */
  .kalk-obal :global(.kalk) {
    display: grid;
    grid-template-columns: 1fr;
    border: 1px solid var(--color-mist);
    background-color: var(--color-paper);
  }

  @media (min-width: 900px) {
    .kalk-obal :global(.kalk) {
      grid-template-columns: 1fr 1fr;
    }

    .kalk-obal :global(.kalk-disclaimer) {
      grid-column: 1 / -1;
    }
  }

  .kalk-obal :global(.kalk-vstupy) {
    padding: 28px;
    display: grid;
    gap: 24px;
    align-content: start;
  }

  .kalk-obal :global(.kalk-pole label),
  .kalk-obal :global(.kalk-legenda) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-graphite);
    margin-bottom: 10px;
  }

  .kalk-obal :global(.kalk-pole label b) {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--color-ink);
  }

  .kalk-obal :global(.kalk-pole input[type="range"]) {
    width: 100%;
    accent-color: var(--color-pirate-dark);
    cursor: pointer;
  }

  .kalk-obal :global(.kalk-prepinac) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .kalk-obal :global(.kalk-prepinac button) {
    flex: 1 1 auto;
    min-width: 72px;
    padding: 10px 14px;
    border: 1px solid var(--color-mist);
    background-color: var(--color-paper);
    color: var(--color-graphite);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;
  }

  .kalk-obal :global(.kalk-prepinac button:hover) {
    border-color: var(--color-pirate);
  }

  .kalk-obal :global(.kalk-prepinac button.je-aktivni) {
    background-color: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-paper);
  }

  .kalk-obal :global(.kalk-vystup) {
    padding: 28px;
    background-color: var(--color-ink);
    color: var(--color-paper);
  }

  .kalk-obal :global(.kalk-stitek) {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-pirate-light);
  }

  .kalk-obal :global(.kalk-cislo) {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 5vw + 1rem, 4rem);
    line-height: 1.05;
    letter-spacing: 0.02em;
    color: var(--color-paper);
    margin-top: 8px;
  }

  .kalk-obal :global(.kalk-podtitul) {
    margin-top: 4px;
    font-size: 15px;
    color: var(--color-mist);
  }

  .kalk-obal :global(.kalk-radky) {
    margin-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }

  .kalk-obal :global(.kalk-radky > div) {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 11px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 14px;
  }

  .kalk-obal :global(.kalk-radky dt) {
    color: var(--color-ash);
  }

  .kalk-obal :global(.kalk-radky dd) {
    font-family: var(--font-mono);
    color: var(--color-paper);
    white-space: nowrap;
  }

  .kalk-obal :global(.kalk-radek-duraz dt) {
    color: var(--color-paper);
    font-weight: 600;
  }

  .kalk-obal :global(.kalk-radek-duraz dd) {
    color: var(--color-pirate-light);
    font-weight: 600;
  }

  .kalk-obal :global(.kalk-hlaska-nadpis) {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2vw + 0.75rem, 1.875rem);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    line-height: 1.15;
    color: var(--color-pirate-light);
    margin-bottom: 12px;
  }

  .kalk-obal :global(.kalk-hlaska p) {
    font-size: 15px;
    color: var(--color-mist);
  }

  .kalk-obal :global(.kalk-hlaska-splatka) {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }

  .kalk-obal :global(.kalk-hlaska-splatka b) {
    font-family: var(--font-mono);
    color: var(--color-paper);
  }

  .kalk-obal :global(.kalk-disclaimer) {
    padding: 18px 28px 22px;
    font-size: 13px;
    line-height: 1.55;
    color: var(--color-smoke);
    background-color: var(--color-cream);
    border-top: 1px solid var(--color-mist);
  }
</style>
