---
import Base from "../layouts/Base.astro";
import { Icon } from "astro-icon/components";
import {
  odvedenaPraceMeta,
  odvedenaPraceStats,
  velkeInvestice,
  oblastiPrace,
  planovano2022,
} from "../lib/odvedenaPrace";
---

<Base
  archiv
  title={odvedenaPraceMeta.title}
  description="Co se v Mariánských Lázních podařilo v letech 2018–2022: investice, opravy silnic, sport, příroda, otevřená radnice — a plán na další období."
>
  <!-- Header -->
  <section
    class="relative overflow-hidden"
    style="background: linear-gradient(135deg, #000000 0%, #0a1f1d 100%);"
  >
    <span
      class="hero-shape"
      style="width: 480px; height: 480px; top: -180px; right: -140px;"
      aria-hidden="true"></span>
    <div class="container-site relative py-20 md:py-28">
      <p class="eyebrow" style="color: var(--color-pirate-light);">
        Realizováno {odvedenaPraceMeta.period}
      </p>
      <h1 class="reveal mt-4" style="color: var(--color-paper); max-width: 22ch;">
        Máme výsledky, ne sliby
      </h1>
      <p
        class="reveal mt-6 text-lg md:text-xl max-w-2xl"
        style="color: var(--color-mist);"
      >
        {odvedenaPraceMeta.lead}
      </p>

      <dl class="reveal mt-10 grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-6">
        {
          odvedenaPraceStats.map((s) => (
            <div>
              <dt class="stat-label">{s.label}</dt>
              <dd class="stat-value">{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Velké investice -->
  <section
    class="section"
    style="background-color: var(--color-off-white);"
    aria-labelledby="investice-heading"
  >
    <div class="container-site">
      <div class="max-w-2xl">
        <p class="eyebrow">Velké investice</p>
        <h2 id="investice-heading" class="mt-3">Co se postavilo a opravilo</h2>
        <p class="mt-4 text-lg" style="color: var(--color-smoke);">
          U investic uvádíme celkové náklady a dotaci, kterou se podařilo
          získat — tam, kde tyto údaje máme.
        </p>
      </div>

      <ul class="mt-10 grid gap-4 md:grid-cols-2">
        {
          velkeInvestice.map((inv) => (
            <li
              class="reveal card flex flex-col gap-3"
              style="border-left: 4px solid var(--color-pirate);"
            >
              <h3 class="invest-title">{inv.title}</h3>
              {inv.note && (
                <p class="text-[15px]" style="color: var(--color-smoke);">
                  {inv.note}
                </p>
              )}
              <dl class="mt-auto flex flex-wrap gap-x-8 gap-y-2 pt-1">
                {inv.cost && (
                  <div>
                    <dt class="mono-meta" style="color: var(--color-smoke);">
                      Náklady
                    </dt>
                    <dd class="invest-num">{inv.cost}</dd>
                  </div>
                )}
                {inv.grant && (
                  <div>
                    <dt class="mono-meta" style="color: var(--color-smoke);">
                      Dotace
                    </dt>
                    <dd class="invest-num" style="color: var(--color-pirate-dark);">
                      {inv.grant}
                    </dd>
                  </div>
                )}
              </dl>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Oblasti -->
  <section class="section" aria-labelledby="oblasti-heading">
    <div class="container-site">
      <div class="max-w-2xl">
        <p class="eyebrow">Po oblastech</p>
        <h2 id="oblasti-heading" class="mt-3">Každodenní město</h2>
        <p class="mt-4 text-lg" style="color: var(--color-smoke);">
          Kromě velkých staveb jde hlavně o věci, které potkáváte cestou do
          práce, do školy nebo na procházce.
        </p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {
          oblastiPrace.map((o) => (
            <article id={o.id} class="reveal card h-full scroll-mt-24">
              <div class="flex items-center gap-4">
                <span
                  class="icon-badge"
                  aria-hidden="true"
                  style="color: var(--color-primary);"
                >
                  <Icon name={o.icon} width={28} height={28} />
                </span>
                <h3 class="invest-title">{o.title}</h3>
              </div>
              <ul class="mt-5 grid gap-3">
                {o.items.map((item) => (
                  <li class="flex gap-3 text-[16px]" style="color: var(--color-graphite);">
                    <Icon
                      name="lucide:check"
                      width={18}
                      height={18}
                      class="shrink-0 mt-1"
                      style="color: var(--color-pirate-dark);"
                      aria-hidden="true"
                    />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Plán 2022–2026 -->
  <section
    class="section"
    style="background-color: var(--color-spa-stone);"
    aria-labelledby="plan-heading"
  >
    <div class="container-site">
      <div class="max-w-2xl">
        <p class="eyebrow" style="color: var(--color-spa-gold);">
          Co jsme plánovali 2022–2026
        </p>
        <h2 id="plan-heading" class="mt-3">Připravené projekty</h2>
        <p class="mt-4 text-lg" style="color: var(--color-smoke);">
          S tímhle plánem jsme počítali na další volební období. Řadu bodů,
          od radnice po osvětlení a skatepark, najdete i v dnešním programu.
        </p>
      </div>

      <ul class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          planovano2022.map((p) => (
            <li
              class="reveal p-5 h-full"
              style="background-color: var(--color-paper); border-top: 3px solid var(--color-spa-gold);"
            >
              <p class="font-semibold text-[16px]" style="color: var(--color-ink);">
                {p.title}
              </p>
              {p.detail && (
                <p class="mt-1 text-[14px]" style="color: var(--color-smoke);">
                  {p.detail}
                </p>
              )}
            </li>
          ))
        }
      </ul>

      <div class="mt-14 flex flex-wrap gap-3 justify-center">
        <a href="/program" class="btn btn-primary">Náš program pro 2026</a>
        <a href="/kandidati" class="btn btn-ghost">Poznejte kandidáty</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .stat-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-pirate-light);
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1.05;
    letter-spacing: 0.02em;
    color: var(--color-paper);
    margin-top: 6px;
  }

  @media (min-width: 768px) {
    .stat-value {
      font-size: 2.5rem;
    }
  }

  .invest-title {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.1;
    color: var(--color-ink);
    font-size: 1.5rem;
  }

  .invest-num {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.1;
    letter-spacing: 0.02em;
    color: var(--color-ink);
  }
</style>
