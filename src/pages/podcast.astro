---
import Base from "../layouts/Base.astro";
import PodcastCard from "../components/PodcastCard.astro";
import { Icon } from "astro-icon/components";
import { podcastEpisodes, contact } from "../lib/site";
---

<Base
  title="Podcast Ze sklepa"
  description="Ze sklepa — podcast Za lepší Mariánské Lázně. Upřímné rozhovory o tom, co Mariánky trápí, co funguje a co bychom udělali jinak."
>
  <!-- Header -->
  <section
    class="relative overflow-hidden"
    style="background: linear-gradient(135deg, #000000 0%, #0a1f1d 100%);"
  >
    <span
      class="hero-shape"
      style="width: 480px; height: 480px; top: -180px; right: -140px;"
      aria-hidden="true"></span>
    <div class="container-site relative py-20 md:py-28">
      <p class="eyebrow" style="color: var(--color-pirate-light);">Podcast</p>
      <h1 class="reveal mt-4" style="color: var(--color-paper);">Ze sklepa</h1>
      <p
        class="reveal mt-6 text-lg md:text-xl max-w-2xl"
        style="color: var(--color-mist);"
      >
        Ze sklepa — podcast Za lepší Mariánské Lázně. Mluvíme o tom,
        co Mariánky trápí, co funguje a co bychom udělali jinak. Žádná
        propaganda — upřímné rozhovory s lidmi, kterým na městě záleží.
      </p>
    </div>
  </section>

  <section class="section" style="background-color: var(--color-off-white);">
    <div class="container-site grid gap-10 lg:grid-cols-[2fr_1fr]">
      <div>
        <h2>Poslední díly</h2>
        <p class="mt-3 text-lg" style="color: var(--color-text-light);">
          První díly právě připravujeme. Sledujte naše sociální sítě
          nebo se přihlaste na oblíbené platformě.
        </p>

        <div class="mt-8 grid gap-6">
          {podcastEpisodes.map((episode) => <PodcastCard episode={episode} />)}
        </div>
      </div>

      <aside
        class="card h-fit"
        style="background-color: var(--color-spa-stone); border-color: var(--color-spa-gold);"
      >
        <h3 style="font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.02em; color: var(--color-ink); font-size: 1.875rem;">
          Poslouchejte kdekoliv
        </h3>
        <p class="mt-3 text-[15px]" style="color: var(--color-text-light);">
          Ze sklepa bude dostupné na všech hlavních platformách.
        </p>
        <ul class="mt-6 space-y-3">
          <li>
            <a
              href={contact.spotify}
              class="flex items-center gap-3 font-semibold"
              style="color: var(--color-dark);"
              rel="noopener"
              target="_blank"
            >
              <span class="icon-badge" aria-hidden="true">
                <Icon name="lucide:music" width={22} height={22} />
              </span>
              Spotify
            </a>
          </li>
          <li>
            <a
              href="#"
              class="flex items-center gap-3 font-semibold"
              style="color: var(--color-dark);"
            >
              <span class="icon-badge" aria-hidden="true">
                <Icon name="lucide:podcast" width={22} height={22} />
              </span>
              Apple Podcasts
            </a>
          </li>
          <li>
            <a
              href={contact.youtube}
              class="flex items-center gap-3 font-semibold"
              style="color: var(--color-dark);"
              rel="noopener"
              target="_blank"
            >
              <span class="icon-badge" aria-hidden="true">
                <Icon name="lucide:youtube" width={22} height={22} />
              </span>
              YouTube
            </a>
          </li>
        </ul>
      </aside>
    </div>
  </section>
</Base>
