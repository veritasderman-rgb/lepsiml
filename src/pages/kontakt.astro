---
import Base from "../layouts/Base.astro";
import { Icon } from "astro-icon/components";
import { contact } from "../lib/site";
---

<Base
  title="Kontakt"
  description="Kontaktujte kandidátku Za lepší Mariánské Lázně. E-mail, telefon, sociální sítě."
>
  <!-- Header -->
  <section
    class="relative overflow-hidden"
    style="background: linear-gradient(135deg, #000000 0%, #0a1f1d 100%);"
  >
    <span
      class="hero-shape"
      style="width: 480px; height: 480px; top: -180px; right: -140px;"
      aria-hidden="true"></span>
    <div class="container-site relative py-20 md:py-28">
      <p class="eyebrow" style="color: var(--color-pirate-light);">Kontakt</p>
      <h1 class="reveal mt-4" style="color: var(--color-paper);">Ozvěte se nám</h1>
      <p
        class="reveal mt-6 text-lg md:text-xl max-w-2xl"
        style="color: var(--color-mist);"
      >
        Chcete se zapojit, kandidovat nebo se jen zeptat?
        Napište nám nebo zavolejte. Ozveme se co nejdřív.
      </p>
    </div>
  </section>

  <section class="section" style="background-color: var(--color-cream);">
    <div class="container-site max-w-3xl">
      <h2>Napište nám nebo zavolejte</h2>
      <p class="mt-3 text-lg" style="color: var(--color-smoke);">
        Nejrychlejší cesta je e-mail nebo telefon.
        Odpovídáme obvykle do dvou pracovních dní.
      </p>

      <div class="mt-10 grid gap-5 sm:grid-cols-2">
        <a
          href={`mailto:${contact.email}`}
          class="card card-hover block"
        >
          <span
            class="icon-badge"
            style="color: var(--color-pirate-dark);"
            aria-hidden="true"
          >
            <Icon name="lucide:mail" width={24} height={24} />
          </span>
          <p
            class="mt-4 eyebrow"
            style="color: var(--color-pirate-dark);"
          >
            E-mail
          </p>
          <p class="mt-1" style="font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.02em; color: var(--color-ink); font-size: 1.25rem;">
            {contact.email}
          </p>
        </a>

        <a
          href={`tel:${contact.phone.replace(/\s/g, "")}`}
          class="card card-hover block"
        >
          <span
            class="icon-badge"
            style="color: var(--color-pirate-dark);"
            aria-hidden="true"
          >
            <Icon name="lucide:phone" width={24} height={24} />
          </span>
          <p
            class="mt-4 eyebrow"
            style="color: var(--color-pirate-dark);"
          >
            Telefon
          </p>
          <p class="mt-1" style="font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.02em; color: var(--color-ink); font-size: 1.25rem;">
            {contact.phone}
          </p>
        </a>

        <a
          href={contact.facebook}
          rel="noopener"
          target="_blank"
          class="card card-hover block"
        >
          <span
            class="icon-badge"
            style="color: var(--color-pirate-dark);"
            aria-hidden="true"
          >
            <Icon name="lucide:facebook" width={24} height={24} />
          </span>
          <p
            class="mt-4 eyebrow"
            style="color: var(--color-pirate-dark);"
          >
            Facebook
          </p>
          <p class="mt-1" style="font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.02em; color: var(--color-ink); font-size: 1.25rem;">
            Piráti ML
          </p>
        </a>

        <a
          href={contact.instagram}
          rel="noopener"
          target="_blank"
          class="card card-hover block"
        >
          <span
            class="icon-badge"
            style="color: var(--color-pirate-dark);"
            aria-hidden="true"
          >
            <Icon name="lucide:instagram" width={24} height={24} />
          </span>
          <p
            class="mt-4 eyebrow"
            style="color: var(--color-pirate-dark);"
          >
            Instagram
          </p>
          <p class="mt-1" style="font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.02em; color: var(--color-ink); font-size: 1.25rem;">
            @pirati_zalepsiml
          </p>
        </a>
      </div>

      <div
        class="mt-12 card"
        style="background-color: var(--color-spa-stone); border-color: var(--color-spa-gold);"
      >
        <h3
          style="font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.02em; color: var(--color-ink); font-size: 1.875rem;"
        >
          Chcete kandidovat?
        </h3>
        <p class="mt-3" style="color: var(--color-graphite);">
          Hledáme lidi, kterým na Mariánkách záleží a chtějí přiložit ruku
          k dílu. Kandidovat můžete i vy — ozvěte se nám a domluvíme si
          nezávaznou schůzku.
        </p>
        <div class="mt-5">
          <a href={`mailto:${contact.email}`} class="btn btn-primary">
            <Icon name="lucide:mail" width={16} height={16} />
            Napsat e-mail
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
